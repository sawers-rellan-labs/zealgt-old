/*
    Profile `stub`: -stub-run wiring checks (Gate 0). Local executor inside the head job's own allocation, tiny resources.
    The container settings are left as the other profiles set them: nf-core modules evaluate their tool version (`eval`
    outputs) even in a stub run, so on hazel (`-profile hazel,stub`) the tasks run in their images (which Gate 0 thereby
    also checks); on the laptop (`-profile stub`, no container engine) version shims must be on PATH (agent/stubbin, not
    tracked).
*/
// Stub outputs never go into the real store: the run guard (zgRunGuards) refuses a stub run whose --outdir lies inside
// ZEAL/store (the store is --outdir; a stub --subsample N run passes --outdir <dir>/subsample_<N>).
// The FASTQ checkpoint keeps its stub rule (checkpoint_stub*, outside /share/maize/frodrig4/fastq_checkpoint). Its hardlinks
// need the filesystem of work/: on the laptop the outdir is fine; on hazel (work/ on /share, outdir on /rsstu) Gate 0 passes
// --fastq_checkpoint /share/maize/frodrig4/nf_work/<run_id>/checkpoint_stub.
params.fastq_checkpoint = "${params.outdir}/checkpoint_stub"
process {
    executor       = 'local'
    cpus           = 1
    memory         = 1.GB
    time           = 10.min
    resourceLimits = [ cpus: 1, memory: 2.GB, time: 30.min ]
    errorStrategy  = 'terminate'
    maxRetries     = 0
}
executor {
    name      = 'local'
    queueSize = 4
}
