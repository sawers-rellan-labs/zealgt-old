/*
    Profile `stub`: -stub-run wiring checks (Gate 0). Local executor inside the head job's own allocation, tiny resources.
    Conda is left as the other profiles set it: nf-core modules evaluate their tool version (`eval` outputs) even in a stub
    run, so on hazel (`-profile hazel,stub`) the tasks run in the prebuilt prefixes (which Gate 0 thereby also checks);
    on the laptop (`-profile stub`, conda off) version shims must be on PATH (agent/stubbin, not tracked).
*/
// Stub outputs never go into the real store: the run guard (zgRunGuards) refuses a stub run whose store path lacks 'stub'.
params.store = "${params.outdir}/store_stub"
process {
    executor       = 'local'
    cpus           = 1
    memory         = 1.GB
    time           = 10.min
    resourceLimits = [ cpus: 1, memory: 2.GB, time: 30.min ]
    errorStrategy  = 'terminate'
    maxRetries     = 0
}
executor {
    name      = 'local'
    queueSize = 4
}
