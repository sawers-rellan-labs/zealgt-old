/*
    Profile `stub`: -stub-run wiring checks (Gate 0). Conda off (stub blocks only touch files), local executor inside the
    head job's own allocation, tiny resources. On hazel: `-profile hazel,stub` (workDir / TMPDIR from hazel.config);
    on the laptop: `-profile stub`.
*/
conda.enabled = false
process {
    executor       = 'local'
    cpus           = 1
    memory         = 1.GB
    time           = 10.min
    resourceLimits = [ cpus: 1, memory: 2.GB, time: 30.min ]
    errorStrategy  = 'terminate'
    maxRetries     = 0
}
executor {
    name      = 'local'
    queueSize = 4
}
