/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
    zealgt (PLAN §2, §5): costly, reusable outputs live in storeDir under the store root, never in work/ and never
    published a second time; nothing is published by default. Store root = params.store, or <store>/subsample_<N> for
    --subsample runs (the same rule as zgStoreRoot() in subworkflows/local/utils_nfcore_zealgt_pipeline):
        <root>/demux_qc      DEMUX_QC      per-library demux QC (tsv, summary, read-start check, cutadapt json + report)
        <root>/cram          ALIGN_MARKDUP CRAM + crai + markdup stats, PROVENANCE; SAMTOOLS_STATS and
                             PICARD_COLLECTWGSMETRICS are published (copied) there (storeDir cannot take their eval outputs)
        <root>/cram_import   the same for MARKDUP_IMPORT (imported zealbc1 / nilhmm CRAMs)
        <root>/registry      REGISTRY      <library>.registry.tsv
    cache 'lenient' (path + size) on the processes with large inputs. Flags come from params (recorded in provenance).
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [ enabled: false ]

    withName: 'DEMUX' {
        ext.args = { params.demux_args }
        maxForks = 1
        cache    = 'lenient'
    }

    withName: 'DEMUX_QC' {
        storeDir = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/demux_qc" }
        ext.args = '--check-reads 100000 --positions 10'
    }

    withName: 'TRIMMOMATIC' {
        ext.args   = { "ILLUMINACLIP:${params.trim_adapters}:${params.trim_illuminaclip} ${params.trim_args}" }
        cache      = 'lenient'
        publishDir = [
            path: { "${params.outdir}/trimmomatic/${meta.library}" },
            mode: params.publish_dir_mode,
            pattern: '*{.summary,_out.log}'
        ]
    }

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        cache      = 'lenient'
        publishDir = [
            path: { "${params.outdir}/fastqc/${meta.library}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'ALIGN_MARKDUP' {
        ext.args  = { params.align_args }
        ext.args2 = { params.markdup_args }
        storeDir  = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram" }
        cache     = 'lenient'
    }

    // nf-core QC modules emit `eval` version outputs, which storeDir does not allow: they publish (copy) into the store
    // instead, and the subworkflows skip a CRAM whose QC file is already there.
    withName: '.*READ_ALIGNMENT:(SAMTOOLS_STATS|PICARD_COLLECTWGSMETRICS)' {
        cache      = 'lenient'
        publishDir = [
            path: { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram" },
            mode: 'copy',
            pattern: '*{.stats,_metrics}'
        ]
    }

    withName: '.*READ_ALIGNMENT:PROVENANCE' {
        storeDir = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram" }
    }

    withName: 'MARKDUP_IMPORT' {
        ext.args = { params.markdup_args }
        storeDir = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram_import" }
        cache    = 'lenient'
    }

    withName: '.*CRAM_IMPORT:(SAMTOOLS_STATS|PICARD_COLLECTWGSMETRICS)' {
        cache      = 'lenient'
        publishDir = [
            path: { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram_import" },
            mode: 'copy',
            pattern: '*{.stats,_metrics}'
        ]
    }

    withName: '.*CRAM_IMPORT:PROVENANCE' {
        storeDir = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/cram_import" }
    }

    withName: 'REGISTRY' {
        storeDir = { "${params.store}${params.subsample.toString().toInteger() ? '/subsample_' + params.subsample : ''}/registry" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        ext.prefix = { "${meta.id}_multiqc_report" }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
