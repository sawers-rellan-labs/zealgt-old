/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
    zealgt (PLAN §2, §5): costly, reusable outputs are published into the store root params.store (mode copy: /rsstu is
    another filesystem than work/; overwrite: false, so a stored file is never replaced; failOnError: true). No storeDir
    (deprecated in the Nextflow 26.10 docs): the CRAM workflow skips work whose stored output exists (workflows/cram.nf,
    zgIsStored / zgStoredQc / zgStoredDemuxQc / zgIsRegistered in subworkflows/local/utils_nfcore_zealgt_pipeline; a
    CRAM counts as stored only with its .crai and the CRAM 3 EOF block). Nothing else is published by default.
        <store>/demux_qc      DEMUX_QC      per-library demux QC (tsv, summary, read-start check, cutadapt json + report)
        <store>/cram          ALIGN_MARKDUP CRAM + crai + markdup stats + versions.yml, SAMTOOLS_STATS, PICARD_COLLECTWGSMETRICS,
                              PROVENANCE
        <store>/cram_import   the same for MARKDUP_IMPORT (imported zealbc1 / nilhmm CRAMs)
        <store>/registry      REGISTRY      <library>.registry.tsv
    FASTQ checkpoint params.fastq_checkpoint (stage 1 -> stage 2): TRIMMOMATIC hardlinks (mode link: same filesystem as
    work/, no extra space or inode) each trimmed pair into <fastq_checkpoint>/<library>/; the samplesheet next to them is
    written by the workflow. A --subsample N run must name the store and the checkpoint subsample_<N>, a stub run
    store_stub* / checkpoint_stub* (zgRunGuards).
    cache 'lenient' (path + size) on the processes with large inputs. Flags come from params (recorded in provenance).
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [ enabled: false ]

    // DEMUX runs per library x lane; all requested libraries run concurrently. No maxForks: the run guards refuse more than
    // --max_libraries libraries (requested + already holding a checkpoint, PLAN §5 rule 3), so at most N x lanes DEMUX
    // tasks exist in a run.
    withName: 'DEMUX' {
        ext.args = { params.demux_args }
        cache    = 'lenient'
    }

    withName: 'MERGE_LANES' {
        cache    = 'lenient'
    }

    withName: 'DEMUX_QC' {
        ext.args   = '--check-reads 100000 --positions 10'
        publishDir = [ path: { "${params.store}/demux_qc" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    // ILLUMINACLIP names the staged adapter FASTA (the patched module's `adapters` input), so no absolute path enters the script.
    // The trimmed pairs are hardlinked into the FASTQ checkpoint (the paths zgDemuxInputs writes into the samplesheet), with
    // the small trim reports (.summary, _out.log; also in MultiQC); a failed link (e.g. a checkpoint on another filesystem
    // than work/) fails the run. One publishDir map, not a list: `nextflow config -o json` (nf-core lint) evaluates every
    // closure inside a publishDir list, and `meta` does not exist at config time (26.04.6).
    withName: 'TRIMMOMATIC' {
        ext.args   = { "ILLUMINACLIP:${adapters}:${params.trim_illuminaclip} ${params.trim_args}" }
        cache      = 'lenient'
        publishDir = [
            path: { "${params.fastq_checkpoint}/${meta.library}" },
            mode: 'link',
            pattern: '*{.paired.trim_1.fastq.gz,.paired.trim_2.fastq.gz,.summary,_out.log}',
            failOnError: true
        ]
    }

    withName: 'FASTQC' {
        ext.args   = '--quiet'
        cache      = 'lenient'
        publishDir = [
            path: { "${params.outdir}/fastqc/${meta.library}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'ALIGN_MARKDUP' {
        ext.args   = { params.align_args }
        ext.args2  = { params.markdup_args }
        cache      = 'lenient'
        publishDir = [ path: { "${params.store}/cram" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    // Imported CRAMs keep zealbc1's MAPQ 20 / -F 0x904 filter, so some records name a mapped mate that is not in the file
    // (Gate 1, PN5_SID464: htsjdk INVALID_FLAG_MATE_UNMAPPED under the default STRICT validation). Coverage metrics do not
    // need mate consistency; SILENT (not LENIENT) keeps .command.err from logging every such record.
    withName: 'PICARD_COLLECTWGSMETRICS' {
        ext.args = '--VALIDATION_STRINGENCY SILENT'
    }

    // QC and provenance next to the CRAM; CRAM_QC_PROVENANCE skips a CRAM whose QC file / record is already there.
    withName: '.*READ_ALIGNMENT:CRAM_QC_PROVENANCE:(SAMTOOLS_STATS|PICARD_COLLECTWGSMETRICS)' {
        cache      = 'lenient'
        publishDir = [ path: { "${params.store}/cram" }, mode: 'copy', pattern: '*{.stats,_metrics}', overwrite: false, failOnError: true ]
    }

    withName: '.*READ_ALIGNMENT:CRAM_QC_PROVENANCE:PROVENANCE' {
        publishDir = [ path: { "${params.store}/cram" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    withName: 'MARKDUP_IMPORT' {
        ext.args   = { params.markdup_args }
        cache      = 'lenient'
        publishDir = [ path: { "${params.store}/cram_import" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    withName: '.*CRAM_IMPORT:CRAM_QC_PROVENANCE:(SAMTOOLS_STATS|PICARD_COLLECTWGSMETRICS)' {
        cache      = 'lenient'
        publishDir = [ path: { "${params.store}/cram_import" }, mode: 'copy', pattern: '*{.stats,_metrics}', overwrite: false, failOnError: true ]
    }

    withName: '.*CRAM_IMPORT:CRAM_QC_PROVENANCE:PROVENANCE' {
        publishDir = [ path: { "${params.store}/cram_import" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    withName: 'REGISTRY' {
        publishDir = [ path: { "${params.store}/registry" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        ext.prefix = { "${meta.id}_multiqc_report" }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
