/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    zealgt on the hazel cluster (NCSU): Slurm executor, prebuilt conda prefixes on /share
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile `hazel` (alias `slurm`); combine with `short` (1 h cap for gates) or `normal`
    (heavy CRAM-workflow tasks on compute/normal, Gate 2 and later) and, for stub runs, `stub`:

        -profile hazel,stub     Gate 0 (-stub-run; conda off, local executor inside the head job)
        -profile hazel,short    Gate 1 (everything on compute_partners / short, every task capped at 1 h)
        -profile hazel,normal   Gate 2 (DEMUX, TRIMMOMATIC, ALIGN_MARKDUP on compute / normal)

    Head job (scripts/submit_head_job.sbatch): a small short-QOS job, 1 cpu, 8 GB (zealbc1 heads peaked at 3.8 of 4 GB),
    never the login node, with in its environment (Slurm exports it to every task job):
        NXF_OFFLINE=true                                   compute nodes have no internet
        NXF_PLUGINS_DIR=<nextflow prefix>/share/nextflow/plugins   nf-schema fetched there by envs/nextflow/build.sh
        PATH=<nextflow prefix>/bin:/usr/local/apps/conda/miniconda3/26.3.2/bin:$PATH   (conda activates the prefixes)
    Rules: PLAN §2 (hash hygiene, published store + skip-if-stored), §5 (work/, TMPDIR and the FASTQ checkpoint on /share,
    results + store on /rsstu, --max_libraries bound), REQUIREMENTS §4 (measured resources), hazel-debug-loop skill.
----------------------------------------------------------------------------------------
*/

// Scratch: work/ and task temp on /share (GPFS, not persistent), one directory per run (params.run_id from the run card),
// never under /rsstu (PLAN §5 rule 1). Published results and the store stay on /rsstu (params.outdir, params.store); the
// FASTQ checkpoint (params.fastq_checkpoint, hardlinks of work/ files) must be on the same /share filesystem as work/.
workDir = "/share/maize/frodrig4/nf_work/${params.run_id ?: 'RUN_ID_NOT_SET'}/work"

env {
    // Sort / markdup temporaries etc. go here; created before every task by process.beforeScript below.
    TMPDIR = "/share/maize/frodrig4/nf_work/${params.run_id ?: 'RUN_ID_NOT_SET'}/tmp"
}

// Environments: every process runs in its prebuilt prefix (conf/env_prefixes.config, generated by
// `scripts/build_envs.sh --write-config`; built by the xfer job scripts/build_envs.sbatch). No env is created at task time: a
// `.nextflow.log` line "Creating env" means a process has no withName entry there.
conda {
    enabled        = true
    channels       = ['conda-forge', 'bioconda']
}
includeConfig 'env_prefixes.config'

executor {
    name               = 'slurm'
    queueSize          = 40              // short QOS; `normal` profile raises it to 80
    submitRateLimit    = '20/1min'
    pollInterval       = '1 min'
    queueStatInterval  = '5 min'
    perCpuMemAllocation = false          // --mem <task.memory> per job (not --mem-per-cpu): the whole request for the task
}

process {
    executor       = 'slurm'
    queue          = 'compute_partners'
    clusterOptions = '--account=maize_cpu --qos=short'

    // TMPDIR (env above) is a per-run dir that nothing else creates; beforeScript (a directive, not in the task hash) makes
    // it. .command.run runs beforeScript BEFORE it exports the env scope, so "$TMPDIR" would still be the node's own temp
    // dir there: the path is spelled out, the same string as env.TMPDIR (scripts/check_resources.sh checks they match).
    beforeScript   = "mkdir -p '/share/maize/frodrig4/nf_work/${params.run_id ?: 'RUN_ID_NOT_SET'}/tmp'"

    // short QOS allows <= 2 h; nothing on this profile may ask for more (the `normal` profile lifts it for the CRAM tasks).
    // Smallest compute / compute_partners nodes: 20 cpu / 125000 MB (sinfo, Phase C1 2026-09-28), so 16 cpu / 120 GB lands anywhere.
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 2.h ]

    // Retry with memory escalation (nilhmm behaviour): 3 attempts; memory requests are written as `<start> * task.attempt`
    // (base.config labels, and the per-module entries below), e.g. ALIGN_MARKDUP 1x / 2x / 3x align_memory_gb. OOM / time-limit /
    // signal exits retry; anything else finishes the run cleanly so the failing task can be read.
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries     = 2

    // Per-label time caps inside the short-QOS limit (base.config defaults are 4-20 h, too long for short).
    withLabel: 'process_single|process_low|process_low_memory' { time = 1.h }
    withLabel: 'process_medium|process_high|process_high_memory|process_long' { time = 2.h }

    // ----- Per-module requests: starting values from the build prompt / REQUIREMENTS §4 "Measured usage" (2026-09-28) -----
    // Resources only here, as directives (not hashed); scripts read them as task.cpus / task.memory (not hashed on
    // Nextflow >= 26.04.6, nextflow-cache skill). Never task.* inside an ext.args closure (hashed; scripts/run_checks.sh).
    // Memory escalates with the attempt (3 attempts); correct these from trace.txt / seff after each gate.
    // DEMUX: measured 3.8-4.7 of 8 cores, 0.61-0.70 GB peak, 53-72 min per BC1 pool; batch-2 row 2.1-2.8 cores, 12-13 min.
    // Since Phase E one DEMUX task is one lane (a BC1 library has 3), so a task takes about a third of those times.
    withName: 'DEMUX' {
        cpus   = { meta.source == 'bc1' ? 6 : 4 }
        memory = { 2.GB * task.attempt }
        time   = 2.h
    }
    // MERGE_LANES: `cat` of the lane files of every sample of one library (I/O only, task.cpus files at a time).
    withName: 'MERGE_LANES' {
        cpus   = 4
        memory = { 1.GB * task.attempt }
        time   = 2.h
    }
    // TRIMMOMATIC: Java; the upstream nf-core module passes no -Xmx, so the bioconda wrapper's default heap (1 GB) applies;
    // measured peak RSS 0.17-0.44 GB, well inside it. FASTQC / PICARD size their heap from task.memory
    // (upstream: FastQC --memory = task.memory / task.cpus, Picard -Xmx = 0.8 x task.memory).
    withName: 'TRIMMOMATIC' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }
    withName: 'FASTQC' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
    // ALIGN_MARKDUP: deep BC1 samples peaked 14.1-22.1 GB, 6.8-7.1 cores, 1 h 46 - 2 h 01 (normal profile lifts the time);
    // Gate 2 (gate2_3A; main checkout agent/20260929_032000_align_rss.tsv + agent/handover_*_gate2.md): with the old
    // (memory - 12 GiB) / 4 sort -m every attempt (24 / 48 / 72 GB) was OOM-killed (sort fills its whole -m x threads budget
    // and overshoots ~5-10 %). The module now sizes sort -m as a bounded share of task.memory (params.align_mem_reserve_gb,
    // params.align_sort_mem_share), so the peak follows the request rather than the source: one first-attempt value for
    // every source, params.align_memory_gb (x attempt), replacing the bc1 24 / other 28 GB split. Gate 2 relaunch: 6 of 8 first
    // attempts at 24 GB still OOM'd. Calibration over all 46 Gate 2 attempts (main checkout agent/20260928_204500_align_memory_calibration.md):
    // peak = M + 1.0 x sort budget; M (minibwa + fixmate) ~ 10 GiB while the sample fits the sort buffer, 17-22.5 GiB once sort
    // spills (every full BC1 sample; depth explains ~5 % of it), design M = 26 GiB (ceiling ~35 GiB at 4E's ~311 M pairs); hazel
    // kills at 95 % of --mem (AllowedRAMSpace). 48 GB with reserve 28 GiB: sort 4 x 3840 MB = 15 GiB, peak ~41 of the 45.6 GiB
    // cap; retries 96 GB, then 120 GB (resourceLimits).
    withName: 'ALIGN_MARKDUP' {
        cpus   = 8
        memory = { params.align_memory_gb.toString().toInteger().GB * task.attempt }
        time   = 2.h
    }
    // Markdup-only pass on imported CRAMs: array 963772 peaked 1.0-11.4 GB, <= 16 min, 2.4 of 4 cores.
    withName: 'MARKDUP_IMPORT' {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    // Per-sample QC: not measured (Picard CollectWgsMetrics never ran in zealbc1); single-threaded Picard over the genome.
    withName: 'SAMTOOLS_STATS|PICARD_COLLECTWGSMETRICS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = 2.h
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
    withName: 'DEMUX_QC|PROVENANCE|REGISTRY' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.min
    }
}

trace {
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,cpus,%cpu,memory,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}
