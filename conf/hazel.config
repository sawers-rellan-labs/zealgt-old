/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    zealgt on the hazel cluster (NCSU): Slurm executor, prebuilt conda prefixes on /share
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile `hazel` (alias `slurm`); combine with `short` (1 h cap for gates) or `normal`
    (heavy CRAM-workflow tasks on compute/normal, Gate 2 and later) and, for stub runs, `stub`:

        -profile hazel,stub     Gate 0 (-stub-run; conda off, local executor inside the head job)
        -profile hazel,short    Gate 1 (everything on compute_partners / short, every task capped at 1 h)
        -profile hazel,normal   Gate 2 (DEMUX, TRIMMOMATIC, ALIGN_MARKDUP on compute / normal)

    Head job (Phase B writes the sbatch wrapper): a small short-QOS job, 1 cpu, 8 GB (zealbc1 heads peaked at 3.8 of 4 GB),
    never the login node, with in its environment (Slurm exports it to every task job):
        NXF_OFFLINE=true                                   compute nodes have no internet
        NXF_PLUGINS_DIR=<nextflow prefix>/share/nextflow/plugins   nf-schema fetched there by envs/nextflow/build.sh
        PATH=<nextflow prefix>/bin:/usr/local/apps/conda/miniconda3/26.3.2/bin:$PATH   (conda activates the prefixes)
    Rules: PLAN §2 (hash hygiene, storeDir), §5 (work/ and TMPDIR on /share, results + store on /rsstu, one library in
    flight), REQUIREMENTS §4 (measured resources), hazel-debug-loop skill.
----------------------------------------------------------------------------------------
*/

// Scratch: work/ and task temp on /share (GPFS, not persistent), one directory per run (params.run_id from the run card),
// never under /rsstu (PLAN §5 rule 1). Published results and the store stay on /rsstu (params.outdir, storeDir).
workDir = "/share/maize/frodrig4/nf_work/${params.run_id ?: 'RUN_ID_NOT_SET'}/work"

env {
    // Created by bin/slurm_resources.sh at the start of every local / patched script; sort temps etc. go here.
    TMPDIR = "/share/maize/frodrig4/nf_work/${params.run_id ?: 'RUN_ID_NOT_SET'}/tmp"
}

// Environments: every process runs in its prebuilt prefix (conf/env_prefixes.config, generated by
// `bin/build_envs.sh --write-config`; built by the xfer job bin/build_envs.sbatch). No env is created at task time: a
// `.nextflow.log` line "Creating env" means a process has no withName entry there.
conda {
    enabled        = true
    channels       = ['conda-forge', 'bioconda']
}
includeConfig 'env_prefixes.config'

executor {
    name               = 'slurm'
    queueSize          = 40              // short QOS; `normal` profile raises it to 80
    submitRateLimit    = '20/1min'
    pollInterval       = '1 min'
    queueStatInterval  = '5 min'
    perCpuMemAllocation = false          // --mem per job, so SLURM_MEM_PER_NODE is set (bin/slurm_resources.sh)
}

process {
    executor       = 'slurm'
    queue          = 'compute_partners'
    clusterOptions = '--account=maize_cpu --qos=short'

    // short QOS allows <= 2 h; nothing on this profile may ask for more (the `normal` profile lifts it for the CRAM tasks).
    // TODO Phase B: confirm hazel node sizes (sinfo) for cpus / memory limits.
    resourceLimits = [ cpus: 16, memory: 128.GB, time: 2.h ]

    // Retry with memory escalation (nilhmm behaviour): 3 attempts; memory requests are written as `<start> * task.attempt`
    // (base.config labels, and the per-module entries below), e.g. ALIGN_MARKDUP 24 -> 48 -> 72 GB. OOM / time-limit /
    // signal exits retry; anything else finishes the run cleanly so the failing task can be read.
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries     = 2

    // Per-label time caps inside the short-QOS limit (base.config defaults are 4-20 h, too long for short).
    withLabel: 'process_single|process_low|process_low_memory' { time = 1.h }
    withLabel: 'process_medium|process_high|process_high_memory|process_long' { time = 2.h }

    // ----- Per-module entries (Phase B), starting requests from the build prompt / REQUIREMENTS §4 "Measured usage" -----
    // Resources only here (never ${task.cpus}/${task.memory} in a script); cache 'lenient' on large-input processes.
    // TODO Phase B: DEMUX              cpus 6, memory 2.GB, maxForks 1 (one library in flight, PLAN §5 rule 3); batch-2 row: 4 cpu 2 GB
    // TODO Phase B: TRIMMOMATIC        cpus 8, memory 8.GB  (-Xmx from ZG_JAVA_MEM_MB)
    // TODO Phase B: FASTQC             cpus 2, memory 4.GB
    // TODO Phase B: ALIGN_MARKDUP      cpus 8, memory { 24.GB * task.attempt } (24 -> 48 -> 72); batch-2 line: 8 cpu 28 GB
    // TODO Phase B: SAMTOOLS_* import  cpus 4, memory 12.GB, time 30.min (markdup-only pass on nilhmm CRAMs)
    // TODO Phase B: SAMTOOLS_STATS, PICARD_COLLECTWGSMETRICS  cpus 2, memory 8.GB, time 1.h;  MULTIQC cpus 1, memory 4.GB
    // TODO Phase B: registry / provenance  process_single
}

trace {
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,cpus,%cpu,memory,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}
