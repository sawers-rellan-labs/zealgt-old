/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Profile `production`: an unattended run that cleans up after itself (user, 2026-10-01; docs/PLAN_pipeline.md §5 rule 4
    production exception, §6 Gate 2 TODO 8). Use with the hazel profiles: -profile hazel,normal,production.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    - cleanup = true: when the run completes SUCCESSFULLY, Nextflow deletes its work/ files; after a failure nothing is
      deleted (the failed task dirs stay for debugging). Tested on 26.04.6 (2026-10-01): success -> 0 task dirs left,
      published files intact (also hardlinked ones); failure -> every task dir kept.
    - remove_verified_checkpoints = true: a successful run also removes the FASTQ checkpoint of every library whose CRAMs are
      all stored and verified (the CRAMs hold every trimmed read). Gate 2 waves run without it: their checkpoints stay
      until genotype Gate 2 (user, 2026-09-29).
    Launching a production run is the user's permission for both (no consent step between waves).
----------------------------------------------------------------------------------------
*/
cleanup = true
params.remove_verified_checkpoints = true
