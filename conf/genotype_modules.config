/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Genotype workflow: per-module options and publishDir (genotype design §2, §8.1)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by nextflow.config after conf/modules.config (which stays the CRAM workflow's). Options come from the run-card
    params (design §5); resources are in conf/genotype_hazel.config.
    Keyed genotype store (design Decision 3): every stage output is published (copied, never overwritten) under
        <outdir>/genotype/<genotype_store_key>/
            sample_qc/                cohort.{min_coverage,panel_coverage,relatedness,relatedness_donors,donor_content,sample_qc}.tsv
            step4/                    <donor>.<label>.sites.tsv.gz, <donor>.<label>.{summary,pool_qc}.tsv, .run_info.txt
            ancestry/                 <donor>.<label>.{tierA_sites,rtiger_markers,counts,line_qc}.tsv, .segments.csv
            union/                    <set>.<label>.tsv.gz, .union_sites.tsv, .per_donor.tsv
            joint_step4/<set>/        <donor>.<label>.sites.tsv.gz, <set>.<label>.{summary,pool_qc}.tsv, .run_info.txt
            gap_bc1/                  <set>.<label>.gap_bc1.tsv.gz, .gap_bc1.summary.tsv
            gap_lines/<set>/          <donor>.<label>.gap_lines.tsv.gz, .gap_lines.summary.tsv
            donor_alleles/<set>/      <donor>.<label>.tsv.gz, .summary.tsv
            genotypes/<set>/          <donor>.<label>.genotypes.tsv.gz, .genotypes.matrix.tsv.gz
    (+ <prefix>.<module>.versions.yml of the python / R template modules). These names are what the upstream check and the
    skip-if-stored check of the utils (zgStoreRel, zgIsStageStored) expect: a unit whose final outputs are there is not
    run again. The later entries read them from <outdir>/genotype/<input_store_key or key>/.
    Published (params.outdir/genotype/<key>/<stage>/): the discovery VCFs, logs and B73 counts, and the reporting tables and
    paintings, which are not kept in the store. Masked BAMs and the other count tables stay in work/.
----------------------------------------------------------------------------------------
*/

process {

    // ---------- stage 2b: sample_quality_control ----------
    withName: 'MIN_COVERAGE|COVERAGE_QC|RELATEDNESS_QC|DONOR_CONTENT_QC|SAMPLE_QC_TABLE' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/sample_qc" }, mode: 'copy', overwrite: false, failOnError: true ]
    }
    withName: 'COVERAGE_QC' {
        ext.when = { params.qc_panel as boolean }
        ext.args = { "--min-markers ${params.panel_min_markers} --report-at 10,100 --regions ${params.regions}" }
    }
    // relatedness_qc / donor_content_qc: run-card switches (WP4 handover)
    withName: 'RELATEDNESS_QC' {
        ext.when = { (params.qc_panel as boolean) && params.relatedness_qc.toString().toLowerCase() == 'true' }
        ext.args = { "--method ${params.relatedness_method} --seed ${params.relatedness_seed} --flag-sd ${params.relatedness_flag_sd} --regions ${params.regions}" }
    }
    withName: 'DONOR_CONTENT_QC' {
        ext.when = { (params.qc_panel as boolean) && params.donor_content_qc.toString().toLowerCase() == 'true' }
        ext.args = { "--expected ${params.donor_content_expected} --flag-low ${params.donor_content_flag_low} --regions ${params.regions}" }
    }
    withName: 'SAMPLE_QC_TABLE' {
        ext.args = { "--fail-on ${params.sample_qc_fail_on}" }
    }

    // ---------- read preparation (every stage that reads the CRAMs) ----------
    withName: 'MASK_READ_STARTS|WITNESS_POOL' {
        cache = 'lenient'
    }

    // ALLELE_COUNTS aliases: mpileup options from the run card; prefixes keep the tables of one unit apart
    withName: 'QC_PANEL_COUNTS|B73_CONTROL_COUNTS|BC1_SITE_COUNTS|LINE_ALLELE_COUNTS|UNION_SITE_COUNTS|B73_UNION_COUNTS|LINE_UNION_COUNTS' {
        ext.args = { params.pileup_args }
        cache    = 'lenient'
    }
    withName: 'B73_CONTROL_COUNTS|B73_UNION_COUNTS' {
        ext.prefix = { "${meta.id}.b73" }
    }
    withName: 'BC1_SITE_COUNTS|UNION_SITE_COUNTS' {
        ext.prefix = { "${meta.id}.bc1" }
    }
    withName: 'LINE_ALLELE_COUNTS|LINE_UNION_COUNTS' {
        ext.prefix = { "${meta.id}.lines" }
    }

    // ---------- stage 3: variant_discovery ----------
    withName: 'CRISP' {
        ext.args   = { params.crisp_args }
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/variant_discovery/${meta.donor}" },
            mode: params.publish_dir_mode,
            pattern: '*.crisp.{vcf.gz,vcf.gz.tbi,log}'
        ]
    }
    withName: 'BED_CLIP' {
        ext.args   = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.inbed" }
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/variant_discovery/${meta.donor}" },
            mode: params.publish_dir_mode,
            pattern: '*.inbed.vcf.gz*'
        ]
    }
    withName: 'WITNESS_VETO' {
        ext.args   = { "--min-alt-reads ${params.veto_min_alt_reads}" }
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/variant_discovery/${meta.donor}" },
            mode: params.publish_dir_mode,
            pattern: '*.{vetoed.vcf.gz,veto_summary.tsv}'
        ]
    }
    withName: 'B73_CONTROL_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/variant_discovery/${meta.donor}" },
            mode: params.publish_dir_mode,
            pattern: '*.b73.ad.tsv.gz'
        ]
    }
    // step 4 per donor x region: tier options from the run card (design §5.2); input format from tier_counts_source
    withName: 'POOLED_LIKELIHOOD_TIERS' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/step4" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.args = { [
            "--input-format ${params.tier_counts_source == 'mpileup' ? 'counts' : 'crisp_vcf'}",
            "--eps0 ${params.tier_eps0} --prior ${params.tier_prior} --plants ${params.tier_plants}",
            "--zero-class-llr ${params.tier_zero_class_llr} --zero-class-min-reads ${params.tier_zero_class_min_reads} --eps-floor ${params.tier_eps_floor}",
            "--llr-a ${params.tier_llr_a} --llr-b ${params.tier_llr_b} --llr-c ${params.tier_llr_c}",
            "--llr-ref ${params.tier_llr_ref} --ref-min-depth ${params.tier_ref_min_depth} --ref-min-pools ${params.tier_ref_min_pools}",
            "--a-min-pools-alt ${params.tier_a_min_pools_alt} --a-single-pool-min-alt ${params.tier_a_single_pool_min_alt}",
            "--hidepth-factor ${params.hidepth_factor} --af-gt-half-p ${params.af_gt_half_p}",
            // WP3 options (defaults = zealbc1)
            "--a-single-pool-max-pools ${params.tier_a_single_pool_max_pools} --af-gt-half-min-depth ${params.tier_af_gt_half_min_depth}",
            "--inconsistent-min-alt ${params.tier_inconsistent_min_alt} --inconsistent-min-depth ${params.tier_inconsistent_min_depth}",
            params.tier_witness_zero_class.toString().toLowerCase() == 'false' ? '--no-witness-zero-class' : '--witness-zero-class',
        ].join(' ') }
    }

    // ---------- stage 4: ancestry_inference ----------
    withName: 'RTIGER_MARKERS|LINE_MARKER_QC|RTIGER' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/ancestry" }, mode: 'copy', overwrite: false, failOnError: true ]
    }
    withName: 'LINE_MARKER_QC' {
        ext.args = { "--drop-invariant ${params.rtiger_drop_invariant_sites.toString().toLowerCase()}" }
    }

    // ---------- stage 5: marker_union ----------
    withName: 'MARKER_UNION' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/union" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    // ---------- stage 6: donor_allele_calling ----------
    // joint step 4 at the union sites, all donors of the set (counts mode, no veto, no witness); --keep-zero-depth keeps the
    // rows where a donor's BC1 pools have no reads, so step 2 has n0 / a0 at those gap sites (WP3 handover)
    withName: 'JOINT_POOLED_LIKELIHOOD' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/joint_step4/${params.donor_set}" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.args = { [
            "--input-format counts --keep-zero-depth",
            "--eps0 ${params.tier_eps0} --prior ${params.tier_prior} --plants ${params.tier_plants}",
            "--zero-class-llr ${params.tier_zero_class_llr} --zero-class-min-reads ${params.tier_zero_class_min_reads} --eps-floor ${params.tier_eps_floor}",
            "--llr-a ${params.tier_llr_a} --llr-b ${params.tier_llr_b} --llr-c ${params.tier_llr_c}",
            "--llr-ref ${params.tier_llr_ref} --ref-min-depth ${params.tier_ref_min_depth} --ref-min-pools ${params.tier_ref_min_pools}",
            "--a-min-pools-alt ${params.tier_a_min_pools_alt} --a-single-pool-min-alt ${params.tier_a_single_pool_min_alt}",
            "--hidepth-factor ${params.hidepth_factor} --af-gt-half-p ${params.af_gt_half_p}",
            "--a-single-pool-max-pools ${params.tier_a_single_pool_max_pools} --af-gt-half-min-depth ${params.tier_af_gt_half_min_depth}",
            "--inconsistent-min-alt ${params.tier_inconsistent_min_alt} --inconsistent-min-depth ${params.tier_inconsistent_min_depth}",
        ].join(' ') }
    }
    // gap_bc1 / gap_lines prefixes: <prefix>.tsv.gz would otherwise be the name of an input of the same task (the union
    // <set>.<label>.tsv.gz; DONOR_FOUNDER's output <donor>.<label>.tsv.gz)
    withName: 'GAP_FILLING_BC1' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/gap_bc1" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.prefix = { "${meta.id}.gap_bc1" }
        ext.args = { [
            "--gap-alt-posterior ${params.gap_alt_posterior} --gap-prior-w ${params.gap_prior_w}",
            "--gap-prior-scope ${params.gap_prior_scope} --gap-prior-source ${params.gap_prior_source} --gap-prior-fixed ${params.gap_prior_fixed}",
            "--ref-llr ${params.tier_llr_ref} --ref-min-depth ${params.tier_ref_min_depth} --tier-prior ${params.tier_prior}",
        ].join(' ') }
    }
    withName: 'GAP_FILLING_LINES' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/gap_lines/${params.donor_set}" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.prefix = { "${meta.id}.gap_lines" }
        ext.args = { [
            "--gap-alt-posterior ${params.gap_alt_posterior} --eps-prior-alpha ${params.eps_prior_alpha} --eps-prior-beta ${params.eps_prior_beta}",
            "--b73-lines-alt-p ${params.b73_lines_alt_p} --ks-floor ${params.ks_floor} --mappability-prior-mode ${params.mappability_prior_mode}",
            "--c-grid-max ${params.c_grid_max} --c-grid-step ${params.c_grid_step}",
            // WP6 options
            "--b73-lines-min-alt ${params.b73_lines_min_alt} --lambda-sites ${params.lambda_sites}",
        ].join(' ') }
    }
    withName: 'DONOR_FOUNDER' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/donor_alleles/${params.donor_set}" }, mode: 'copy', overwrite: false, failOnError: true ]
    }

    // ---------- stage 7: genotype_imputation ----------
    // .genotypes prefix: donor_alleles/<set>/<donor>.<label>.tsv.gz is RASTERIZE's (and GENOTYPE_SUMMARY's) input, so the
    // genotype table cannot share that file name
    withName: 'RASTERIZE' {
        publishDir = [ path: { "${params.outdir}/genotype/${params.genotype_store_key}/genotypes/${params.donor_set}" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.prefix = { "${meta.id}.genotypes" }
    }

    // ---------- stage 8: reporting (published only) ----------
    // the edge translation (meta/PROVENANCE.md "Identifiers"): the final genotype tables, the exclusion table and the labels
    // table carry the short label; its relabelled segments / line_qc only feed the reports and are not published
    withName: 'SAMPLE_LABELS' {
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/reporting/${params.donor_set}" },
            mode: params.publish_dir_mode,
            pattern: '*.{genotypes.tsv.gz,genotypes.matrix.tsv.gz,exclusions.tsv,sample_labels.tsv}'
        ]
    }
    withName: 'GENOTYPE_SUMMARY' {
        ext.args   = { "--expectation ${params.reporting_expectation} --breakpoint-window ${params.breakpoint_window_markers}" }
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/reporting/${params.donor_set}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
    withName: 'CHROMOSOME_PAINTING' {
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/reporting/${params.donor_set}" },
            mode: params.publish_dir_mode,
            pattern: '*.painting.{png,pdf}'
        ]
    }
    withName: 'READ_POSITION_QC' {
        ext.args   = '-q 20 -F 0xF04'
        ext.args2  = '--min-bq 20'
        publishDir = [
            path: { "${params.outdir}/genotype/${params.genotype_store_key}/reporting/${params.donor_set}/read_position_qc" },
            mode: params.publish_dir_mode,
            pattern: '*.read_position_qc.tsv'
        ]
    }
}
