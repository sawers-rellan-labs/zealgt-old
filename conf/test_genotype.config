/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the genotype-workflow fixture runs (profile test_genotype; genotype design §7.2)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    --workflow genotype on tests/fixtures/genotype (written by tests/fixtures/genotype/make_fixtures.py): a CRAM store with
    the cram_import layout (8 synthetic CRAMs + crai, CollectWgsMetrics, provenance.json), the reference slice
    ref/tiny10.fa (chr10, chr9), a lowcopy BED slice, the blind-panel fixture, the mexicana mappability prior and a
    read-only step-4 table of the reference donor Zx.9002_P1. One run donor (Zx.9001_P1), one region (chr10:1-16000,
    label chr10_1-16000), store key 'test'. Local executor; scripts read task.cpus (capped by resourceLimits below).

    --entry runs one stage (sample_quality_control by default here); a later entry needs the earlier stages' outputs in
    <store>/genotype/test/ (run the entries in order on one --outdir, or copy the kinds you need from
    tests/fixtures/genotype/store_seed/genotype/test/, as tests/genotype.nf.test does):
        nextflow run . -profile test_genotype,stub -stub --outdir <OUTDIR> [--entry <stage>]   (wiring only)
        nextflow run . -profile test_genotype --outdir <OUTDIR> [--entry <stage>]              (tools on PATH)
    The thresholds that depend on scale are lowered to fit 12 tier-A markers (rigidity, panel_min_markers); everything
    else keeps the nextflow.config defaults.
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'local'
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    workflow               = 'genotype'
    entry                  = 'sample_quality_control'
    genotype_input         = "${projectDir}/tests/fixtures/genotype/genotype_samples_test.csv"
    cram_store             = "${projectDir}/tests/fixtures/genotype/cram_store"
    fasta                  = "${projectDir}/tests/fixtures/genotype/ref/tiny10.fa"
    lowcopy_bed            = "${projectDir}/tests/fixtures/genotype/lowcopy.bed"
    qc_panel               = "${projectDir}/tests/fixtures/genotype/panel.tsv"
    mappability_priors     = "${projectDir}/tests/fixtures/genotype/priors"
    reference_donor_tables = "Zx.9002_P1=${projectDir}/tests/fixtures/genotype/reference/Zx.9002_P1.sites.tsv.gz"
    regions                = 'chr10:1-16000'
    donors                 = 'Zx.9001_P1'
    donor_set              = 'test_set'
    genotype_store_key     = 'test'
    b73_controls           = 'B73_CTL'
    run_id                 = 'test_genotype'
    store                  = "${params.outdir}/store_test_genotype"   // profile stub (declared last) sets <outdir>/store_stub
    // scale: 12 own tier-A markers in the fixture region (floor = max(ceil(factor x rigidity), 2 x rigidity) = 6)
    rigidity               = 3
    rigidity_ref_markers   = 0        // no density scaling on the fixture (12 markers in 16 kb of a tiny contig)
    min_markers_factor     = 2
    panel_min_markers      = 4
}
