/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Genotype workflow on hazel: per-process resources (genotype design §4; REQUIREMENTS §4)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by the hazel / slurm profiles after conf/hazel.config, which sets the Slurm executor, compute_partners, the
    short QOS (--account=maize_cpu --qos=short), retries (3 attempts) and resourceLimits. Resources only here, as
    directives (not hashed: a change here never reruns a cached task); scripts read them as task.cpus (not hashed on
    Nextflow >= 26.04.6, nextflow-cache skill). Never task.* inside an ext.args closure (conf/genotype_modules.config;
    scripts/run_checks.sh). One withName key per process, as in conf/hazel.config; scripts/check_resources.sh checks the
    resolved values against tests/expected_resources.tsv. Memory and time x task.attempt. Every request fits the short
    QOS; the `short` profile caps each task at 1 h. Values from REQUIREMENTS §4 / zealbc1 sbatch requests and Gate 1;
    whole-chr10 measurements: agent/handover_20260929_194500_genotype_benchmark.md.
----------------------------------------------------------------------------------------
*/

process {
    // BC1 / line / B73 groups of region-limited, masked BAMs; task.cpus samples in parallel
    withName: 'MASK_READ_STARTS' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // merge of ~40 line BAMs into the witness pool, one pipe (samtools -@ task.cpus)
    withName: 'WITNESS_POOL' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // CRISP is single-threaded (0.35 GB measured, REQUIREMENTS.md:56); bgzip uses the second core
    withName: 'CRISP' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // nf-core bcftools/view (--threads task.cpus)
    withName: 'BED_CLIP' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // "seconds, < 1 GB" (REQUIREMENTS.md:57)
    withName: 'WITNESS_VETO' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'REGION_BED' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'RTIGER_MARKERS' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'MARKER_UNION' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // bcftools mpileup batched per donor x region x role (zealbc1 count_union_sample.sbatch 2 cpu / 8 GB per sample)
    withName: 'QC_PANEL_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'B73_CONTROL_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'BC1_SITE_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'LINE_ALLELE_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'UNION_SITE_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'B73_UNION_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'LINE_UNION_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // "< 16 GB, ~1 min joint" (REQUIREMENTS.md:58)
    withName: 'POOLED_LIKELIHOOD_TIERS' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'JOINT_POOLED_LIKELIHOOD' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // step-2 python asked 12 GB in the pilot
    withName: 'GAP_FILLING_BC1' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'GAP_FILLING_LINES' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    withName: 'DONOR_FOUNDER' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // line coverage floor and RTIGER input
    withName: 'LINE_MARKER_QC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // "4 cpu / < 16 GB, ~1-2 min" (REQUIREMENTS.md:59; zealbc1 rtiger_ancestry_inference.sbatch); nilHMM threads = task.cpus
    withName: 'RTIGER' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }

    // stage 2b tables, "1-2 cpu, < 4 GB" (REQUIREMENTS.md:55); RELATEDNESS_QC is pure python: run 2b per donor set
    withName: 'MIN_COVERAGE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'COVERAGE_QC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'RELATEDNESS_QC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'DONOR_CONTENT_QC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'SAMPLE_QC_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // long table ~40 lines x 80 k sites
    withName: 'RASTERIZE' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }
    withName: 'GENOTYPE_SUMMARY' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // streams the long table (only the registry and the label map are held in memory)
    withName: 'SAMPLE_LABELS' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // chromosome paintings (R)
    withName: 'CHROMOSOME_PAINTING' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
    }

    // array 969611 ran 4 cpu / 16 G for a few minutes; samples in parallel over task.cpus
    withName: 'READ_POSITION_QC' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
}
