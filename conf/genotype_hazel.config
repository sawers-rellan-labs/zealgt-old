/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Genotype workflow on hazel: per-process resources (genotype design §4; REQUIREMENTS §4)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by the hazel / slurm profiles after conf/hazel.config, which sets the Slurm executor, compute_partners, the
    short QOS (--account=maize_cpu --qos=short), retries (3 attempts) and resourceLimits. Every request below fits the short
    QOS and the `short` profile's 1 h cap. Scripts read the allocation from bin/export_slurm_resources.sh (ZG_CPUS / ZG_MEM_MB),
    so a change here keeps every task hash. Memory escalates with the attempt, as in conf/hazel.config. Starting values from
    REQUIREMENTS §4 / zealbc1 sbatch requests; correct them from trace.txt after Gate 1.
----------------------------------------------------------------------------------------
*/

process {
    // BC1 / line / B73 groups of region-limited, masked BAMs; ZG_CPUS samples in parallel
    withName: 'MASK_READ_STARTS' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
    // merge of ~40 line BAMs into the witness pool, one pipe
    withName: 'WITNESS_POOL' {
        cpus   = 8
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }
    // CRISP is single-threaded (0.35 GB measured, REQUIREMENTS.md:56); bgzip / tabix use the second core
    withName: 'CRISP' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
    withName: 'BED_CLIP' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.min
    }
    // "seconds, < 1 GB" (REQUIREMENTS.md:57)
    withName: 'WITNESS_VETO|REGION_BED|RTIGER_MARKERS|UNION_SITES|MARKER_UNION' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.min
    }
    // bcftools mpileup batched per donor x region x role (zealbc1 count_union_sample.sbatch 2 cpu / 8 GB per sample)
    withName: 'QC_PANEL_COUNTS|B73_CONTROL_COUNTS|BC1_SITE_COUNTS|LINE_ALLELE_COUNTS|UNION_SITE_COUNTS|B73_UNION_COUNTS|LINE_UNION_COUNTS' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }
    // "< 16 GB, ~1 min joint" (REQUIREMENTS.md:58)
    withName: 'POOLED_LIKELIHOOD_TIERS|JOINT_POOLED_LIKELIHOOD' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }
    // step-2 python asked 12 GB in the pilot
    withName: 'GAP_FILLING_BC1|GAP_FILLING_LINES|DONOR_FOUNDER' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 1.h
    }
    withName: 'LINE_MARKER_QC' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 30.min
    }
    // "4 cpu / < 16 GB, ~1-2 min" (REQUIREMENTS.md:59; zealbc1 rtiger_ancestry_inference.sbatch)
    withName: 'RTIGER' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = 1.h
    }
    // stage 2b tables, "1-2 cpu, < 4 GB" (REQUIREMENTS.md:55); RELATEDNESS_QC is pure python: run 2b per donor set
    withName: 'MIN_COVERAGE|COVERAGE_QC|RELATEDNESS_QC|DONOR_CONTENT_QC|SAMPLE_QC_TABLE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 30.min
    }
    // long table ~40 lines x 80 k sites
    withName: 'RASTERIZE|GENOTYPE_SUMMARY' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = 30.min
    }
    // streams the long table (only the registry and the label map are held in memory)
    withName: 'SAMPLE_LABELS' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 30.min
    }
    withName: 'CHROMOSOME_PAINTING' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = 30.min
    }
    // array 969611 ran 4 cpu / 16 G for a few minutes
    withName: 'READ_POSITION_QC' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = 1.h
    }
}
