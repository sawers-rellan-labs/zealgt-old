/*
    Profile `local`: local executor inside ONE Slurm allocation on hazel (interactive debugging of a single task), with
    the prebuilt conda prefixes. Tasks share that allocation, so resources come from the explicit override below, not
    from SLURM_* (bin/export_slurm_resources.sh honours ZG_CPUS / ZG_MEM_MB only together with ZG_RESOURCES_OVERRIDE=local).
    Use as `-profile hazel,local` (workDir / TMPDIR on /share). Edit ZG_CPUS / ZG_MEM_MB to what one task may use; no silent default.
*/
conda.enabled = true
includeConfig 'env_prefixes.config'
process {
    executor       = 'local'
    resourceLimits = [ cpus: 4, memory: 16.GB, time: 2.h ]
    maxRetries     = 0
}
executor {
    name      = 'local'
    queueSize = 1
}
env {
    ZG_RESOURCES_OVERRIDE = 'local'
    ZG_CPUS               = '2'
    ZG_MEM_MB             = '6144'
}
