/*
    Profile `local`: local executor inside ONE Slurm allocation on hazel (interactive debugging of a single task), tasks in
    their images as with `hazel`. Scripts read task.cpus / task.memory, so resourceLimits below caps what one task may use
    (keep it within the allocation); queueSize 1 runs one task at a time.
    Use as `-profile hazel,local` (workDir / TMPDIR on /share).
*/
process {
    executor       = 'local'
    resourceLimits = [ cpus: 4, memory: 16.GB, time: 2.h ]
    maxRetries     = 0
}
executor {
    name      = 'local'
    queueSize = 1
}
