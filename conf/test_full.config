/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Gate 1 on hazel (docs/PLAN_pipeline.md §6): BC1 pool 1A, first 1,000,000 read pairs, real tools, short QOS, into its own
    subsample store. 1A is in the registry seed, so the run names it with --force_demux on purpose.

    Use as follows (a head job, never the login node; hazel-debug-loop skill):
        sbatch scripts/submit_head_job.sbatch gate1_1A -profile hazel,short,test_full --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    entry      = 'read_demultiplexing'
    libraries   = '1A'
    force_demux = '1A'
    subsample   = 1000000
    store       = '/rsstu/users/r/rrellan/BZea/ZEAL/store/subsample_1000000'
}
