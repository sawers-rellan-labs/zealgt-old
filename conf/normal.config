/*
    Profile `normal` (with `hazel`): the CRAM workflow's deep-library tasks on compute / normal QOS (Gate 2 and later).
    Everything else stays on compute_partners / short. Starting times from REQUIREMENTS §4 (DEMUX 53-72 min per BC1
    pool, deep ALIGN 1 h 46 - 2 h 01): 4 h requested, the time limit lifted to 24 h for these processes only.
*/
executor {
    queueSize = 80
}
process {
    // PICARD_COLLECTWGSMETRICS walks the whole genome single-threaded (never measured on a full BC1 sample): here too.
    // FASTQC: Gate 1 (1M pairs) extrapolates to ~2 h for a deep BC1 sample (~250 M pairs, 2 threads), over the 1 h short cap.
    withName: 'DEMUX|TRIMMOMATIC|FASTQC|ALIGN_MARKDUP|PICARD_COLLECTWGSMETRICS' {
        queue          = 'compute'
        clusterOptions = '--account=maize_cpu --qos=normal'
        time           = { 4.h * task.attempt }
        resourceLimits = [ cpus: 16, memory: 120.GB, time: 24.h ]
    }
    // TRIMMOMATIC: Gate 1 measured ~10 k pairs/s (I/O-bound, 2.5-3 of 8 cores) -> ~7 h for a ~255 M-pair BC1 sample.
    withName: 'TRIMMOMATIC' {
        time = { 12.h * task.attempt }
    }
}
