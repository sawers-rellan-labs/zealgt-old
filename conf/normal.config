/*
    Profile `normal` (with `hazel`): production runs (Gate 2 and later). The per-process requests stay in
    conf/hazel.config (sized per task from its input, x task.attempt); this file only lifts the time limit to 24 h and
    routes each task by its own time request: <= 1 h 45 -> compute_partners / short QOS (2 h cap, ample idle capacity),
    else compute / normal QOS (1,024 cpus per user). A deep sample's ALIGN_MARKDUP goes to normal, its FASTQC to short;
    a retry doubles the time and may move the task to normal.
*/
executor {
    queueSize = 160     // N = 4 BC1 libraries keep ~100-150 tasks in flight (Gate 3 projection §4)
}
process {
    // No withName / withLabel selector here, only process-wide values: a selector added here would sit after hazel.config's
    // and win over it for every process it matches (Gate 2: a combined DEMUX|TRIMMOMATIC|... selector here overrode
    // hazel.config's times, and a later `withName: 'TRIMMOMATIC'` 12 h block merged into hazel.config's entry and lost).
    // hazel.config sets queue / clusterOptions / resourceLimits process-wide only, so these replace them for every process.
    // task.time is the task's resolved request (hazel.config's closure for this task and attempt). scripts/check_resources.sh
    // checks the routing (tests/expected_resources.tsv: fixtures -> short; the 310 M pair size probe -> normal).
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 24.h ]
    queue          = { (task.time ?: 24.h) <= 105.min ? 'compute_partners' : 'compute' }
    clusterOptions = { (task.time ?: 24.h) <= 105.min ? '--account=maize_cpu --qos=short' : '--account=maize_cpu --qos=normal' }
}
