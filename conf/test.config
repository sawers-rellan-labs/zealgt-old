/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    --entry read_demultiplexing on the tiny fixture library LIBX (tests/fixtures: 3 samples, 2 lanes, 940 read pairs) against
    tests/fixtures/ref/tiny.fa (with .fai and the minibwa .l2b / .mbw). Local executor; the scripts read task.cpus /
    task.memory, capped by resourceLimits below. The store and the FASTQ checkpoint go under the outdir (the checkpoint's
    hardlinks need the filesystem of work/). Stage 2 alone: add --entry read_alignment (same outdir or --fastq_checkpoint).

    Use as follows (the tools must be on PATH or in conda envs; linux-64 pins, docs/usage.md):
        nextflow run sawers-rellan-labs/zealgt -profile test,conda --outdir <OUTDIR>
        nextflow run sawers-rellan-labs/zealgt -profile test,stub -stub --outdir <OUTDIR>     (wiring only)
    nf-test runs the same profile (nf-test.config).
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'local'
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
    // cutadapt -j 2 with gz outputs crashes a worker on macOS (spawn); fine on Linux
    withName: 'DEMUX' {
        cpus = 1
    }
}

params {
    input        = "${projectDir}/tests/fixtures/samples_test.csv"
    libraries     = 'LIBX'
    fasta         = "${projectDir}/tests/fixtures/ref/tiny.fa"
    store            = "${params.outdir}/store_test"
    fastq_checkpoint = "${params.outdir}/checkpoint_test"
}
