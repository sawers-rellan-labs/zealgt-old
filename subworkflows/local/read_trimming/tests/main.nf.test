nextflow_workflow {

    name "Test Subworkflow READ_TRIMMING"
    script "../main.nf"
    workflow "READ_TRIMMING"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "read_trimming"
    tag "cutadapt"
    tag "fastqc"
    tag "stub"

    test("LX_1 - stub") {

        options "-stub"

        when {
            params {
                store            = "${outputDir}/store_stub"
                fastq_checkpoint = "${outputDir}/checkpoint_stub"
            }
            workflow {
                """
                input[0] = channel.of([
                    [ id:'LX_1', sample:'LX_1', library:'LIBX', source:'bc1', qc_group:'LIBX', single_end:false ],
                    [ file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true), file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true) ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // the trimmed pair and the cutadapt log are hardlinked into the FASTQ checkpoint (conf/modules.config)
                { assert file("${outputDir}/checkpoint_stub/LIBX/LX_1_1.trim.fastq.gz").exists() },
                { assert file("${outputDir}/checkpoint_stub/LIBX/LX_1_2.trim.fastq.gz").exists() },
                { assert file("${outputDir}/checkpoint_stub/LIBX/LX_1.cutadapt.log").exists() },
                { assert snapshot(
                    workflow.out.reads.collect { meta, reads -> [meta.id, reads.collect { f -> file(f).name }.sort()] },
                    workflow.out.qc.collect { meta, f -> "${meta.id} ${file(f).name}".toString() }.sort(),
                    workflow.out.versions.collect { v -> v.toString() }.sort()
                ).match() }
            )
        }
    }
}
