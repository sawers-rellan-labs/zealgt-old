nextflow_workflow {

    name "Test Subworkflow READ_DEMULTIPLEXING"
    script "../main.nf"
    workflow "READ_DEMULTIPLEXING"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "read_demultiplexing"
    tag "demux"
    tag "demux_qc"
    tag "merge_lanes"
    tag "stub"

    test("LIBX, 3 samples, 6B2S+T symmetric - stub") {

        options "-stub"

        when {
            params {
                store = "${outputDir}/store_stub"
            }
            workflow {
                """
                input[0] = channel.of([
                    [ id:'LIBX', library:'LIBX', source:'bc1', layout:'symmetric', n_samples:3, pu:'TESTFC01.1,TESTFC01.2' ],
                    [ file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true), file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L2_1.fq.gz", checkIfExists: true) ],
                    [ file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true), file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L2_2.fq.gz", checkIfExists: true) ],
                    [ ['LX_1', 'GCCATA', 'GCCATA'], ['LX_2', 'TCTGGT', 'TCTGGT'], ['LX_3', 'TGGCTT', 'TGGCTT'] ],
                    [ '6B2S+T', '6B2S+T' ],
                    [ [], [] ]
                ])
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.reads[0][1].size() == 6 },
                { assert file("${outputDir}/store_stub/demux_qc/LIBX.tsv").exists() },
                { assert snapshot(
                    workflow.out.reads.collect { meta, fastqs -> [meta.id, fastqs.collect { f -> file(f).name }.sort()] },
                    workflow.out.demux_qc.collect { meta, tsv -> [meta.id, file(tsv).name] },
                    workflow.out.summary.collect { meta, tsv -> [meta.id, file(tsv).name] },
                    workflow.out.versions.collect { v -> v.toString() }.sort()
                ).match() }
            )
        }
    }
}
