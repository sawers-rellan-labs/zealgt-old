/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    sawers-rellan-labs/zealgt Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Workflow and entry (main.nf dispatcher; docs/PLAN_pipeline.md §3)
    workflow                   = 'cram'      // cram | genotype
    entry                      = 'read_demultiplexing' // cram: read_demultiplexing (stage 1, chains into 2) | read_alignment (stage 2) | markdup_import; genotype: one of the 7 stages

    // Input options (sheets validated and parsed by nf-schema: assets/schema_input.json, assets/schema_import.json,
    // assets/schema_checkpoint.json)
    input                      = "${projectDir}/meta/samples.csv"     // the single sample sheet (library, barcodes, read groups)
    registry                   = "${projectDir}/meta/registry.csv"    // sample-identity registry: provenance registry snapshot (meta/PROVENANCE.md)
    import_sheet               = "${projectDir}/meta/dev_import.csv"  // markdup_import: existing CRAMs to import
    libraries                  = null        // read_demultiplexing / read_alignment: library ids (samples.csv 'library'), comma-separated
    force_demux                = null        // libraries to demultiplex although registered (PLAN §0 Task 2)
    max_libraries              = 4           // read_demultiplexing: requested + checkpoint-holding libraries <= N, else refused (PLAN §5 rule 3)
    subsample                  = 0           // read pairs per library for Gate 1 (0 = all); needs --outdir / --fastq_checkpoint <...>/subsample_<N>
    import_samples             = null        // markdup_import: restrict to these sample_ids
    import_sets                = null        // markdup_import: restrict to these import_set values
    raw_r1_glob                = '*_1.fq.gz' // lane files of a plain-FASTQ library in its raw_location
    raw_r2_glob                = '*_2.fq.gz'

    // Reference and FASTQ checkpoint; no site paths here (nf-core): hazel's are set in conf/hazel.config. The permanent
    // home of every stored output is --outdir itself (one --outdir for all runs; PLAN §6 Gate 2 TODO 7).
    fastq_checkpoint           = null        // <library>/: trimmed pairs + samplesheet.csv (on the filesystem of work/: hardlinks)
    fasta                      = null        // reference FASTA; + .fai, minibwa .l2b / .mbw next to it
    registry_seed              = "${projectDir}/assets/registry_seed.csv"

    // Read-processing settings (recorded in every provenance record)
    read_structure_symmetric   = '6B2S+T 6B2S+T'   // BC1, BC2S3 batch 2 (Twist FlexPrep UHT; the 2 skip bases confirmed, job 968980)
    read_structure_r1_only     = '8B12S+T 8S+T'    // BC2S3 batch 1 (Twist 96-Plex): 8-bp barcode + 12 randomer on R1, 8 randomer on R2 (raw tars, job 969161)
    demux_args                 = '-e 0 --no-indels --discard-untrimmed -Z'
    // CUTADAPT (conf/modules.config: ext.args = -a <r1> -A <r2> <trim_args>): full TruSeq read-through adapters; trim_args
    // --nextseq-trim=15 (two-colour poly-G-aware 3' quality trim), -m 36 (drop a pair with a read shorter than 36 bp) and
    // --compression-level 4 (gzip of the checkpoint FASTQs; here, not in the module, so provenance records it; user
    // 2026-09-29), chosen by the Trimmomatic-vs-cutadapt comparison and its compression retest (meta/PROVENANCE.md,
    // docs/REQUIREMENTS.md §4)
    trim_adapter_r1            = 'AGATCGGAAGAGCACACGTCTGAACTCCAGTCA'
    trim_adapter_r2            = 'AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT'
    trim_args                  = '--nextseq-trim=15 -m 36 --compression-level 4'
    align_args                 = '-x sr'
    markdup_args               = '-d 2500'

    // Genotype workflow (--workflow genotype; run card -params-file docs/runs/<run>.yml; genotype design §5)
    // selection, inputs, store
    genotype_input             = "${projectDir}/meta/genotype_dev.csv" // genotype sample sheet (assets/schema_genotype.json)
    cram_store                 = null        // read-only CRAM store: <cram_store>/{cram,cram_import}/<id>.* (hazel: conf/hazel.config)
    genotype_store_key         = null        // required: outputs go to <outdir>/genotype/<key>/ (settings guard)
    input_store_key            = null        // upstream outputs are read from this key (default: genotype_store_key)
    donors                     = null        // required: donors of this run (sheet 'donor'), comma-separated
    donor_set                  = null        // required from marker_union on: name of the union set
    regions                    = 'chr10'     // <chrom> or <chrom>:<start>-<end>, comma-separated; Gate 1 chr10:1-20000000
    lowcopy_bed                = '/rsstu/users/r/rrellan/BZea/ZEAL/results/pilot_1B_chr10/union/union_chr10.bed' // chr10 only
    qc_panel                   = null        // blind QC panel positions (stage 2b); null = panel QC not run
    annotation_panels          = null        // step-4 annotation columns: name=path,...
    mappability_priors         = null        // required by donor_allele_calling: directory of <taxon>.prior.tsv
    mappability_prior_mode     = 'taxon'     // taxon | flat
    b73_controls               = 'B73_ERR3288215,B73_skim10' // zero-class pools (sheet role b73_control)
    provenance_check           = 'strict'    // strict | warn
    mask_read_starts           = true        // false = every read-start mask 0 (same code path)
    imputation_method          = 'raster'    // raster | phg | both (PHG later)
    read_position_qc           = true
    // thresholds (zealbc1 / plan values)
    min_coverage               = 0.05
    panel_min_markers          = 1000
    relatedness_method         = 'vanraden_pseudohaploid'
    relatedness_seed           = 1
    relatedness_flag_sd        = 3
    donor_content_expected     = 0.125
    donor_content_flag_low     = 0.03
    relatedness_qc             = true
    donor_content_qc           = true
    sample_qc_fail_on          = 'relatedness,donor_content'
    pileup_args                = '-q 20 -Q 20 -d 10000'
    crisp_args                 = '-p 12 --mmq 20 --filterreads 0 --minc 2'
    veto_min_alt_reads         = 1
    tier_counts_source         = 'crisp'     // crisp | mpileup
    tier_eps0                  = 0.005
    tier_prior                 = 0.5
    tier_plants                = 6
    tier_zero_class_llr        = -3
    tier_zero_class_min_reads  = 20
    tier_eps_floor             = 0.001
    tier_llr_a                 = 6.9
    tier_llr_b                 = 4.6
    tier_llr_c                 = 2.2
    tier_llr_ref               = -4
    tier_ref_min_depth         = 12
    tier_a_min_pools_alt       = 2
    tier_a_single_pool_min_alt = 0           // 0 = off
    tier_ref_min_pools         = 1
    tier_a_single_pool_max_pools = 2
    hidepth_factor             = 2
    af_gt_half_p               = 0.01
    tier_af_gt_half_min_depth  = 4
    tier_inconsistent_min_alt  = 3
    tier_inconsistent_min_depth = 10
    tier_witness_zero_class    = true
    rigidity                   = 500         // RTIGER rigidity at rigidity_ref_markers markers per chromosome (user, 2026-09-29)
    rigidity_ref_markers       = 100000      // scaled per donor x chromosome to its marker count; 0 = rigidity as given
    min_markers_factor         = 2
    rtiger_drop_invariant_sites = true
    gap_alt_posterior          = 0.999
    gap_prior_w                = 2
    gap_prior_scope            = 'all'       // all | same_taxon
    gap_prior_source           = 'other_donors' // other_donors | fixed | mu_only
    gap_prior_fixed            = 0.5
    reference_donor_tables     = null        // donor=path,...: read-only step-4 tables of donors not called in this run
    reference_donor_taxa       = null        // donor=taxon,...: taxon of each reference donor (gap_prior_scope same_taxon)
    eps_prior_alpha            = 1
    eps_prior_beta             = 200
    b73_lines_alt_p            = 0.01
    b73_lines_min_alt          = 1
    lambda_sites               = 'all'
    c_grid_max                 = 1.5
    c_grid_step                = 0.05
    ks_floor                   = 0.02
    phg_inbreeding             = 0
    phg_prob_same_gamete       = 0.99999
    reporting_expectation      = 'bc2s2'     // bc2s2 | bc2s3
    breakpoint_window_markers  = 500
    // registry (8: SAMPLE_LABELS edge translation, recorded, not guarded) is the shared param above (input/output options)
    // Memory tuning (hidden; conf/hazel.config ALIGN_MARKDUP memory, samtools sort -m in modules/local/align_markdup and
    // markdup_import). Gate 2 (gate2_3A + relaunch): main checkout agent/20260929_032000_align_rss.tsv + agent/handover_*_gate2.md;
    // calibration (main checkout agent/20260928_204500_align_memory_calibration.md): peak = M + 1.0 x sort budget, M ~ 10 GiB unspilled, 17-22.5 GiB once sort spills (design 26 GiB);
    // hazel kills a job at 95 % of its --mem (AllowedRAMSpace).
    align_memory_gb            = 48   // ALIGN_MARKDUP first-attempt memory, GB (x task.attempt; peak ~26 + 15 = 41 of 45.6 GiB cap)
    align_mem_reserve_gb       = 28   // ALIGN_MARKDUP: GB kept out of sort -m (minibwa + fixmate M, design 26 GiB, + headroom)
    align_sort_mem_share       = 0.75 // share of (memory - reserve) given to sort -m x threads (sort RSS ~1.0 x budget)
    import_mem_reserve_gb      = 2    // MARKDUP_IMPORT: GB kept out of sort -m (no minibwa index; streaming stages)

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/' // template; zealgt tests use tests/fixtures
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Schema validation default options
    validate_params            = true

    // zealgt run options
    run_id                     = null   // names the scratch dir /share/maize/frodrig4/nf_work/<run_id> (conf/hazel.config)
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
    test_genotype { includeConfig 'conf/test_genotype.config' }
    // zealgt execution profiles (conf/hazel.config header): hazel,stub | hazel,short | hazel,normal | hazel,local
    // (genotype-process resources in conf/genotype_hazel.config, so conf/hazel.config stays the CRAM workflow's)
    hazel {
        includeConfig 'conf/hazel.config'
        includeConfig 'conf/genotype_hazel.config'
    }
    slurm {
        includeConfig 'conf/hazel.config'
        includeConfig 'conf/genotype_hazel.config'
    }
    short     { includeConfig 'conf/short.config'     }
    normal    { includeConfig 'conf/normal.config'    }
    local     { includeConfig 'conf/local.config'     }
    // stub last: Nextflow applies profiles in the order they are declared here, so stub's executor, resources and store win
    stub      { includeConfig 'conf/stub.config'      }
}



// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.run_id ?: 'run'}/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.run_id ?: 'run'}/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.run_id ?: 'run'}/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/${params.run_id ?: 'run'}/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'sawers-rellan-labs/zealgt'
    contributors    = [
        [
            name: 'Fausto Rodríguez Zapata',
            affiliation: 'North Carolina State University',
            email: 'faustovrz@gmail.com',
            github: '@faustovrz',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/sawers-rellan-labs/zealgt'
    description     = """ZEAL genotyping: raw libraries to analysis-ready CRAMs (CRAM workflow) and CRAM store to ancestry and imputed genotypes (genotype workflow)"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=25.10.4'
    version         = '0.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
// Genotype-workflow process options (ext.args / storeDir / publishDir), kept apart so conf/modules.config stays the CRAM workflow's
includeConfig 'conf/genotype_modules.config'
