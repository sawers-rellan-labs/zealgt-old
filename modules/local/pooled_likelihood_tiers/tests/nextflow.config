// Test-only settings (the pipeline's live in conf/genotype_modules.config): the store publishDir under the test's store_stub, options from a param.
process {
    withName: 'POOLED_LIKELIHOOD_TIERS' {
        ext.args = { params.tiers_test_args ?: '' }
        publishDir = [ path: { "${params.store}/genotype/test/step4" }, mode: 'copy', overwrite: false, failOnError: true ]
    }
}
