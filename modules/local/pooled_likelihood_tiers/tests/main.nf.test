nextflow_process {

    name "Test Process POOLED_LIKELIHOOD_TIERS"
    script "../main.nf"
    process "POOLED_LIKELIHOOD_TIERS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "pooled_likelihood_tiers"

    // Independent LLR of one pool (math supplement Eq. llr, 6 plants): log sum_j C(6,j)/64 Bin(a; n, p_j) - log Bin(a; n, eps)
    def llrPool = { int n, int a, double eps ->
        if (n == 0) { return 0.0d }
        def w = [1, 6, 15, 20, 15, 6, 1]
        def l1 = (0..6).sum { j -> def f = j / 12.0d; def p = f * (1 - eps) + (1 - f) * eps
            (w[j] / 64.0d) * Math.pow(p, a) * Math.pow(1 - p, n - a) }
        Math.log(l1) - Math.log(Math.pow(eps, a) * Math.pow(1 - eps, n - a))
    }

    def sampleMap = """[
        ['S_2A_3', 'Zx.0540_P3', 'mexicana', 'bc1_sample'],
        ['S_2A_11', 'Zx.0540_P3', 'mexicana', 'bc1_sample'],
        ['Zx0540_P3_BC2S3', 'BC2S3', 'mapping_pop', 'witness'],
        ['B73_ERR3288215', 'B73', 'maize', 'b73_control'],
        ['B73_skim10', 'B73', 'maize', 'b73_control']
    ]"""

    def data = "\${projectDir}/modules/local/pooled_likelihood_tiers/tests/data"

    test("Zx.0540_P3.chrA - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                store = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ],
                             file("${data}/calls.vcf.gz", checkIfExists: true), [ file("${data}/b73.ad.tsv.gz", checkIfExists: true) ], [] ]
                input[1] = ${sampleMap}
                input[2] = 'chrA'
                input[3] = [ [], [] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.sites[0][1]).name == "Zx.0540_P3.chrA.sites.tsv.gz" },
                { assert file(process.out.summary[0][1]).name == "Zx.0540_P3.chrA.summary.tsv" },
                { assert file("${outputDir}/store_stub/genotype/test/step4/Zx.0540_P3.chrA.sites.tsv.gz").exists() }
            )
        }
    }

    test("Zx.0540_P3.chrA - crisp_vcf tiers") {

        when {
            params {
                store = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ],
                             file("${data}/calls.vcf.gz", checkIfExists: true), [ file("${data}/b73.ad.tsv.gz", checkIfExists: true) ], [] ]
                input[1] = ${sampleMap}
                input[2] = 'chrA'
                input[3] = [ [ 'panel' ], [ file("${data}/annot.tsv", checkIfExists: true) ] ]
                """
            }
        }

        then {
            def lines = path(process.out.sites[0][1]).linesGzip
            def cols = lines[0].split('\t') as List
            def rows = lines.drop(1).collectEntries { l -> def x = l.split('\t', -1); [ (x[1]): [cols, x as List].transpose().collectEntries() ] }
            def eps1001 = 0.5d / 61
            def llr1001 = llrPool(20, 5, eps1001) + llrPool(20, 4, eps1001)
            assertAll(
                { assert process.success },
                { assert cols == [ 'chrom', 'pos', 'ref', 'alt', 'n', 'a', 'n_pools', 'n_pools_alt', 'eps', 'n0', 'a0', 'self_in_zero',
                                   'LLR', 'logodds', 'posterior', 'tier', 'flags', 'in_panel', 'pool_counts' ] },
                { assert rows.keySet() == [ '1001', '1500', '2001', '2500', '3001', '3500' ] as Set },
                { assert rows.collectEntries { p, r -> [ (p): r.tier ] } == [ '1001':'A', '1500':'ref', '2001':'C', '2500':'B', '3001':'C', '3500':'A' ] },
                { assert rows['1001'].flags == '.' },
                { assert rows['1001'].n0 == '60' && rows['1001'].a0 == '0' && rows['1001'].self_in_zero == '0' },
                { assert Math.abs((rows['1001'].eps as double) - eps1001) < 1e-12 },
                { assert Math.abs((rows['1001'].LLR as double) - llr1001) < 1e-9 },
                { assert Math.abs((rows['1001'].logodds as double) - llr1001) < 1e-9 },
                { assert rows['1001'].n == '40' && rows['1001'].a == '9' && rows['1001'].n_pools_alt == '2' },
                { assert rows['1001'].pool_counts == 'S_2A_3:5/20;S_2A_11:4/20' },
                { assert rows['1001'].in_panel == '1' && rows['2500'].in_panel == '1' && rows['1500'].in_panel == '0' },
                { assert rows['2001'].flags == 'af_gt_half' },
                { assert rows['2500'].flags == 'inconsistent' },
                { assert rows['3001'].flags == 'hidepth' },
                { assert rows['3001'].n0 == '301' && rows['3001'].a0 == '1' },
                { assert rows['3500'].flags == 'no_zero_class' && (rows['3500'].eps as double) == 0.005d },
                { assert (rows['1500'].LLR as double) <= -4 },
                { assert path(process.out.summary[0][1]).readLines() == [
                    "donor\ttaxon\tn_pools\ttested\tA\tB\tC\tref\t-\tA_in_panel\tB_in_panel\tC_in_panel",
                    "Zx.0540_P3\tmexicana\t2\t6\t2\t1\t2\t1\t0\t1\t1\t0" ] },
                { assert path(process.out.pool_qc[0][1]).readLines().size() == 6 },
                { assert path(process.out.run_info[0][1]).readLines().contains("skipped_not_biallelic_snp\t2") },
                // the sites table holds full-precision floats (libm may differ in the last digit across platforms): asserted above, not snapshotted
                { assert snapshot(process.out.summary, process.out.pool_qc).match() }
            )
        }
    }

    test("Zx.0540_P3.chrA - counts input gives the crisp_vcf LLR") {

        when {
            params {
                store = "${outputDir}/store_stub"
                tiers_test_args = '--input-format counts'
            }
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ],
                             [ file("${data}/bc1.ad.tsv.gz", checkIfExists: true) ], [ file("${data}/b73.ad.tsv.gz", checkIfExists: true) ],
                             [ file("${data}/sites.tsv", checkIfExists: true) ] ]
                input[1] = ${sampleMap}
                input[2] = 'chrA'
                input[3] = [ [], [] ]
                """
            }
        }

        then {
            def lines = path(process.out.sites[0][1]).linesGzip
            def cols = lines[0].split('\t') as List
            def rows = lines.drop(1).collectEntries { l -> def x = l.split('\t', -1); [ (x[1]): [cols, x as List].transpose().collectEntries() ] }
            def eps1001 = 0.5d / 61
            assertAll(
                { assert process.success },
                { assert rows.keySet() == [ '1001', '1500', '2001', '2500', '3001', '3500' ] as Set },
                { assert Math.abs((rows['1001'].LLR as double) - (llrPool(20, 5, eps1001) + llrPool(20, 4, eps1001))) < 1e-9 },
                { assert rows['3001'].n0 == '301' && rows['3001'].a0 == '1' },
                { assert rows['2500'].tier == 'B' && rows['1500'].tier == 'ref' }
            )
        }
    }

    test("gate1.chrA - joint run of two donors") {

        when {
            params {
                store = "${outputDir}/store_stub"
                tiers_test_args = '--input-format counts --keep-zero-depth'
            }
            process {
                """
                input[0] = [ [ id:'gate1.chrA', donor_set:'gate1', region:'chrA' ],
                             [ file("${data}/bc1.ad.tsv.gz", checkIfExists: true), file("${data}/d2.ad.tsv.gz", checkIfExists: true) ],
                             [ file("${data}/b73.ad.tsv.gz", checkIfExists: true) ], [ file("${data}/sites.tsv", checkIfExists: true) ] ]
                input[1] = [
                    ['S_2A_3', 'Zx.0540_P3', 'mexicana', 'bc1_sample'],
                    ['S_2A_11', 'Zx.0540_P3', 'mexicana', 'bc1_sample'],
                    ['S_3A_1', 'Zx.0570_P2', 'mexicana', 'bc1_sample'],
                    ['B73_ERR3288215', 'B73', 'maize', 'b73_control'],
                    ['B73_skim10', 'B73', 'maize', 'b73_control']
                ]
                input[2] = 'chrA'
                input[3] = [ [], [] ]
                """
            }
        }

        then {
            def tables = process.out.sites[0][1].collectEntries { f -> [ (file(f).name): f ] }
            def parse = { f -> def lines = path(f).linesGzip; def cols = lines[0].split('\t') as List
                lines.drop(1).collectEntries { l -> def x = l.split('\t', -1); [ (x[1]): [cols, x as List].transpose().collectEntries() ] } }
            def d1 = parse(tables['Zx.0540_P3.chrA.sites.tsv.gz'])
            def d2 = parse(tables['Zx.0570_P2.chrA.sites.tsv.gz'])
            assertAll(
                { assert process.success },
                { assert tables.keySet() == [ 'Zx.0540_P3.chrA.sites.tsv.gz', 'Zx.0570_P2.chrA.sites.tsv.gz' ] as Set },
                { assert d1['1001'].n0 == '100' && d1['1001'].self_in_zero == '0' },
                { assert d2['1001'].self_in_zero == '1' && d2['1001'].flags.contains('single_sample') && d2['1001'].tier == '-' },
                { assert d2['3500'].n == '0' && d2['3500'].tier == '-' },
                { assert file("${outputDir}/store_stub/genotype/test/step4/Zx.0570_P2.chrA.sites.tsv.gz").exists() },
                { assert path(process.out.summary[0][1]).readLines().size() == 3 }
            )
        }
    }

    test("pool missing from the sample map - fails") {

        when {
            params {
                store = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA' ], file("${data}/calls.vcf.gz", checkIfExists: true), [], [] ]
                input[1] = [ ['S_2A_3', 'Zx.0540_P3', 'mexicana', 'bc1_sample'], ['S_2A_11', 'Zx.0540_P3', 'mexicana', 'bc1_sample'] ]
                input[2] = 'chrA'
                input[3] = [ [], [] ]
                """
            }
        }

        then {
            assert process.failed
        }
    }
}
