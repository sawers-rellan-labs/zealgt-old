nextflow_process {

    name "Test Process CHROMOSOME_PAINTING"
    script "../main.nf"
    process "CHROMOSOME_PAINTING"

    tag "modules"
    tag "modules_local"
    tag "chromosome_painting"
    tag "stub"

    test("Zx.0001_P1.chrA_1-5000 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'Zx.0001_P1.chrA_1-5000', donor:'Zx.0001_P1', region:'chrA_1-5000' ],
                    file("${projectDir}/modules/local/gap_filling_lines/tests/data/Zx.0001_P1.chrA_1-5000.segments.csv", checkIfExists: true),
                    file("${projectDir}/modules/local/gap_filling_lines/tests/data/Zx.0001_P1.chrA_1-5000.line_qc.tsv", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.png[0][1]).name == "Zx.0001_P1.chrA_1-5000.painting.png" },
                { assert file(process.out.pdf[0][1]).name == "Zx.0001_P1.chrA_1-5000.painting.pdf" }
            )
        }
    }
}
