nextflow_process {

    name "Test Process COVERAGE_QC"
    script "../main.nf"
    process "COVERAGE_QC"

    tag "modules"
    tag "modules_local"
    tag "coverage_qc"

    // Fixture panel (the blind QC panel does not exist yet, design §10 item 6):
    // modules/local/relatedness_qc/tests/fixtures (make_panel_fixture.py).
    test("cohort - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                def d = "${projectDir}/modules/local/relatedness_qc/tests/fixtures"
                input[0] = channel.of([ [ id:'cohort' ], [ file("\${d}/D1.panel.ad.tsv.gz", checkIfExists: true) ] ])
                input[1] = file("\${d}/panel.tsv", checkIfExists: true)
                input[2] = [ ['L1', 'line', 'D1'] ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.tsv[0][1]).name == "cohort.panel_coverage.tsv" }
            )
        }
    }

    test("cohort - real") {

        tag "real"

        config "./nextflow.config"

        when {
            process {
                """
                def d = "${projectDir}/modules/local/relatedness_qc/tests/fixtures"
                input[0] = channel.of([
                    [ id:'cohort' ],
                    [
                        file("\${d}/D1.panel.ad.tsv.gz", checkIfExists: true),
                        file("\${d}/D2.panel.ad.tsv.gz", checkIfExists: true),
                        file("\${d}/b73.panel.ad.tsv.gz", checkIfExists: true)
                    ]
                ])
                input[1] = file("\${d}/panel.tsv", checkIfExists: true)
                input[2] = new groovy.json.JsonSlurper().parse(file("\${d}/sample_map.json")) + [ ['GHOST', 'line', 'D1'] ]
                """
            }
        }

        then {
            def rows = path(process.out.tsv[0][1]).readLines().collect { it.split('\t') as List }
            def hdr = rows[0]
            def byS = rows.drop(1).collectEntries { [ (it[0]): it ] }
            assertAll(
                { assert process.success },
                { assert hdr == ['sample', 'role', 'donor', 'contig', 'n_sites', 'covered', 'covered_frac', 'reads', 'mean_depth', 'counted', 'below_min_markers', 'below_10', 'below_100'] },
                { assert rows.size() == 1 + 16 },
                // regions chr10:1000-2073 (nextflow.config) keep 30 of the 60 panel sites
                { assert byS['L1'][4] == '30' },
                // BC1 pools have 4-8 reads at every site: all 30 covered, above the floor of 20 (nextflow.config)
                { assert byS['B1'][5] == '30' && byS['B1'][10] == 'false' },
                { assert byS['GHOST'][5] == '0' && byS['GHOST'][9] == 'false' && byS['GHOST'][10] == 'true' },
                { assert byS['K1'][2] == '.' },
                { assert snapshot(process.out.tsv).match() }
            )
        }
    }
}
