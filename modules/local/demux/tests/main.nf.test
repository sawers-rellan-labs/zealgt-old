nextflow_process {

    name "Test Process DEMUX"
    script "../main.nf"
    process "DEMUX"

    tag "modules"
    tag "modules_local"
    tag "demux"

    test("LIBX lane L1 of 2, 3 samples, 6B2S+T symmetric - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBX.LIBX_TESTFC01_L1', library:'LIBX', source:'bc1', layout:'symmetric', n_samples:3, pu:'TESTFC01.1,TESTFC01.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true),
                    [ ['LX_1', 'GCCATA', 'GCCATA'], ['LX_2', 'TCTGGT', 'TCTGGT'], ['LX_3', 'TGGCTT', 'TGGCTT'] ],
                    [ '6B2S+T', '6B2S+T' ],
                    [ '', '' ],
                    2
                ])
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.reads[0][1].size() == 6 },
                { assert process.out.reads[0][1].collect { f -> file(f).name }.sort() == ["LX_1", "LX_2", "LX_3"].collectMany { s -> ["${s}.LIBX.LIBX_TESTFC01_L1_R1.fastq.gz", "${s}.LIBX.LIBX_TESTFC01_L1_R2.fastq.gz"] }.collect { n -> n.toString() } },
                { assert file(process.out.json[0][1]).name == "LIBX.LIBX_TESTFC01_L1.cutadapt.json" },
                { assert process.out.versions_cutadapt.size() == 1 }
            )
        }
    }

    // Batch-1 path (audit G8): lane L001 of the fixture plate tars LIBB1 (tests/fixtures/raw/LIBB1/R{1,2}.tar, made by
    // agent/20260928_163000_make_batch1_fixture.py), R1-only 8-bp barcodes, 8B12S+T / 8S+T, one empty well (PB1_SID4).
    test("LIBB1 lane L001 of 2 (tar members), 4 samples, 8B12S+T 8S+T r1_only - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBB1.LIBB1_S1_L001', library:'LIBB1', source:'bc2s3_batch1', layout:'r1_only', n_samples:4, pu:'TESTFCB1.1,TESTFCB1.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R1.tar", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                    [ ['PB1_SID1', 'CGTACGTA', ''], ['PB1_SID2', 'AGGAACGT', ''], ['PB1_SID3', 'CTAGCTAG', ''], ['PB1_SID4', 'CTCTCAGT', ''] ],
                    [ '8B12S+T', '8S+T' ],
                    [ 'LIBB1_R1/LIBB1_S1_L001_R1_001.fastq.gz', 'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz' ],
                    2
                ])
                input[1] = 0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.reads[0][1].collect { f -> file(f).name }.sort() == (1..4).collectMany { i -> ["PB1_SID${i}.LIBB1.LIBB1_S1_L001_R1.fastq.gz", "PB1_SID${i}.LIBB1.LIBB1_S1_L001_R2.fastq.gz"] }.collect { n -> n.toString() } },
                { assert file(process.out.json[0][1]).name == "LIBB1.LIBB1_S1_L001.cutadapt.json" }
            )
        }
    }

    // Real runs (tag demux_real: need cutadapt 4.9, pigz and tar on PATH; scripts/run_checks.sh runs the stub tag only). Every
    // demultiplexed R1 must be raw R1[20:] and every R2 raw R2[8:]: the fixture reads carry tiny.fa chrA sequence right after
    // barcode + randomer, so a cropped R1 is a substring of chrA and a cropped R2 one of its reverse complement; a crop one
    // base short would leave a random base in front.
    test("LIBB1 lane L001 of 2 (tar members), r1_only, full lane - real") {

        tag "demux_real"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBB1.LIBB1_S1_L001', library:'LIBB1', source:'bc2s3_batch1', layout:'r1_only', n_samples:4, pu:'TESTFCB1.1,TESTFCB1.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R1.tar", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                    [ ['PB1_SID1', 'CGTACGTA', ''], ['PB1_SID2', 'AGGAACGT', ''], ['PB1_SID3', 'CTAGCTAG', ''], ['PB1_SID4', 'CTCTCAGT', ''] ],
                    [ '8B12S+T', '8S+T' ],
                    [ 'LIBB1_R1/LIBB1_S1_L001_R1_001.fastq.gz', 'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz' ],
                    2
                ])
                input[1] = 0
                """
            }
        }

        then {
            def chrA = new File("${baseDir}/tests/fixtures/ref/tiny.fa").text.split('>chrB')[0].readLines().drop(1).join('')
            def rc = chrA.reverse().tr('ACGT', 'TGCA')
            def reads = process.out.reads[0][1].collectEntries { f -> [file(f).name, path(f).linesGzip] }
            def field = { String n, int k -> def ls = reads[n]; (0..<(ls.size().intdiv(4))).collect { j -> ls[4 * j + k] } }
            def r1 = (1..4).collectMany { i -> field("PB1_SID${i}.LIBB1.LIBB1_S1_L001_R1.fastq.gz", 1) }
            def r2 = (1..4).collectMany { i -> field("PB1_SID${i}.LIBB1.LIBB1_S1_L001_R2.fastq.gz", 1) }
            def names = { String n -> field(n, 0).collect { l -> l.tokenize(' ')[0] } }
            def counts = (1..4).collect { i -> field("PB1_SID${i}.LIBB1.LIBB1_S1_L001_R1.fastq.gz", 1).size() }
            def json = new groovy.json.JsonSlurper().parse(new File(process.out.json[0][1].toString()))
            def taskdir = new File(process.out.json[0][1].toString()).parentFile
            assertAll(
                { assert process.success },
                // 30 / 20 / 10 / 0 pairs per well, 8 pairs of no well discarded; the empty well still gets its (empty) files
                { assert counts == [30, 20, 10, 0] },
                { assert json.read_counts.input == 68 && json.read_counts.output == 60 },
                // crops: R1 100 - 20, R2 100 - 8, exactly the genome sequence
                { assert r1.size() == 60 && r1.every { s -> s.size() == 80 && chrA.contains(s) } },
                { assert r2.size() == 60 && r2.every { s -> s.size() == 92 && rc.contains(s) } },
                // mates stay in step
                { assert (1..3).every { i -> names("PB1_SID${i}.LIBB1.LIBB1_S1_L001_R1.fastq.gz") == names("PB1_SID${i}.LIBB1.LIBB1_S1_L001_R2.fastq.gz") } },
                // the extracted members are gone from the task dir (EXIT trap)
                { assert !taskdir.listFiles().any { f -> f.name.startsWith('LIBB1.LIBB1_S1_L001_R') } },
                // the plain-FASTQ FIFOs cutadapt wrote into are gone too (EXIT trap); only the .fastq.gz remain
                { assert new File(taskdir, 'demux').listFiles().collect { f -> f.name }.every { n -> n.endsWith('.fastq.gz') } }
            )
        }
    }

    // --subsample: the head of the lane, re-compressed, then the same cutadapt call as the full run (audit G2). The fixture
    // lane is ordered by well, so its first 10 pairs are PB1_SID1's.
    test("LIBB1 lane L001 of 2 (tar members), --subsample 20 (10 pairs per lane) - real") {

        tag "demux_real"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBB1.LIBB1_S1_L001', library:'LIBB1', source:'bc2s3_batch1', layout:'r1_only', n_samples:4, pu:'TESTFCB1.1,TESTFCB1.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R1.tar", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                    [ ['PB1_SID1', 'CGTACGTA', ''], ['PB1_SID2', 'AGGAACGT', ''], ['PB1_SID3', 'CTAGCTAG', ''], ['PB1_SID4', 'CTCTCAGT', ''] ],
                    [ '8B12S+T', '8S+T' ],
                    [ 'LIBB1_R1/LIBB1_S1_L001_R1_001.fastq.gz', 'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz' ],
                    2
                ])
                input[1] = 20
                """
            }
        }

        then {
            def json = new groovy.json.JsonSlurper().parse(new File(process.out.json[0][1].toString()))
            def counts = (1..4).collect { i -> path(process.out.reads[0][1].find { f -> file(f).name == "PB1_SID${i}.LIBB1.LIBB1_S1_L001_R1.fastq.gz" }).linesGzip.size().intdiv(4) }
            def cmd = new File(new File(process.out.json[0][1].toString()).parentFile, '.command.sh').text
            assertAll(
                { assert process.success },
                { assert json.read_counts.input == 10 && counts == [10, 0, 0, 0] },
                // cutadapt reads a gz file in the task dir, as in the full run
                { assert cmd.contains('pigz -1 -p') && cmd.contains('in1=LIBB1.LIBB1_S1_L001_R1.fastq.gz') }
            )
        }
    }

    // --subsample on a corrupt input: pipefail is off around `... | head` (head's early exit SIGPIPEs the producers), so the
    // module checks PIPESTATUS itself. A truncated gzip member (tests/fixtures/raw/LIBB1_BAD/R1.tar: LIBB1's L001 R1 member
    // cut to half, agent/20260929_123000_make_corrupt_member_fixture.py) and a missing member must fail the task, not give a
    // short or empty lane. --subsample 200 = 100 pairs per lane, more than the lane holds, so head reads to the corrupt end.
    test("LIBB1_BAD lane L001, truncated R1 member, --subsample 200 - real, fails") {

        tag "demux_real"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBB1.LIBB1_S1_L001', library:'LIBB1', source:'bc2s3_batch1', layout:'r1_only', n_samples:4, pu:'TESTFCB1.1,TESTFCB1.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBB1_BAD/R1.tar", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                    [ ['PB1_SID1', 'CGTACGTA', ''], ['PB1_SID2', 'AGGAACGT', ''], ['PB1_SID3', 'CTAGCTAG', ''], ['PB1_SID4', 'CTCTCAGT', ''] ],
                    [ '8B12S+T', '8S+T' ],
                    [ 'LIBB1_R1/LIBB1_S1_L001_R1_001.fastq.gz', 'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz' ],
                    2
                ])
                input[1] = 200
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                // stage 2 of 4 (the decompressor) exited non-zero
                { assert process.stdout.any { l -> l.contains('--subsample input of R1 failed: stage 2 of 4') } }
            )
        }
    }

    test("LIBB1 lane L001, R1 member missing from the tar, --subsample 20 - real, fails") {

        tag "demux_real"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBB1.LIBB1_S1_L001', library:'LIBB1', source:'bc2s3_batch1', layout:'r1_only', n_samples:4, pu:'TESTFCB1.1,TESTFCB1.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R1.tar", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBB1/R2.tar", checkIfExists: true),
                    [ ['PB1_SID1', 'CGTACGTA', ''], ['PB1_SID2', 'AGGAACGT', ''], ['PB1_SID3', 'CTAGCTAG', ''], ['PB1_SID4', 'CTCTCAGT', ''] ],
                    [ '8B12S+T', '8S+T' ],
                    [ 'LIBB1_R1/LIBB1_S1_L009_R1_001.fastq.gz', 'LIBB1_R2/LIBB1_S1_L001_R2_001.fastq.gz' ],
                    2
                ])
                input[1] = 20
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                // stage 1 of 4 (tar) exited non-zero
                { assert process.stdout.any { l -> l.contains('--subsample input of R1 failed: stage 1 of 4') } }
            )
        }
    }

    // The BC1 plain-FASTQ path under --subsample: the same head + re-compress code as the tar path.
    test("LIBX lane L1 of 2, 6B2S+T symmetric, --subsample 100 (50 pairs per lane) - real") {

        tag "demux_real"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBX.LIBX_TESTFC01_L1', library:'LIBX', source:'bc1', layout:'symmetric', n_samples:3, pu:'TESTFC01.1,TESTFC01.2', n_lanes:2 ],
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_1.fq.gz", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/raw/LIBX/LIBX_TESTFC01_L1_2.fq.gz", checkIfExists: true),
                    [ ['LX_1', 'GCCATA', 'GCCATA'], ['LX_2', 'TCTGGT', 'TCTGGT'], ['LX_3', 'TGGCTT', 'TGGCTT'] ],
                    [ '6B2S+T', '6B2S+T' ],
                    [ '', '' ],
                    2
                ])
                input[1] = 100
                """
            }
        }

        then {
            def json = new groovy.json.JsonSlurper().parse(new File(process.out.json[0][1].toString()))
            def cmd = new File(new File(process.out.json[0][1].toString()).parentFile, '.command.sh').text
            assertAll(
                { assert process.success },
                { assert json.read_counts.input == 50 },
                { assert process.out.reads[0][1].size() == 6 },
                { assert cmd.contains('in1=LIBX.LIBX_TESTFC01_L1_R1.fastq.gz') }
            )
        }
    }
}
