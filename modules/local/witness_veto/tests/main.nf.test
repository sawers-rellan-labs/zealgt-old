nextflow_process {

    name "Test Process WITNESS_VETO"
    script "../main.nf"
    process "WITNESS_VETO"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "witness_veto"

    test("Zx.0540_P3.chrA - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ], file("${projectDir}/modules/local/witness_veto/tests/data/inbed.vcf.gz", checkIfExists: true) ]
                input[1] = 'Zx0540_P3_BC2S3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.vcf[0][1]).name == "Zx.0540_P3.chrA.vetoed.vcf.gz" },
                { assert file(process.out.sites[0][1]).name == "Zx.0540_P3.chrA.kept_sites.tsv" }
            )
        }
    }

    test("Zx.0540_P3.chrA - veto at >= 1 ALT read") {

        when {
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ], file("${projectDir}/modules/local/witness_veto/tests/data/inbed.vcf.gz", checkIfExists: true) ]
                input[1] = 'Zx0540_P3_BC2S3'
                """
            }
        }

        then {
            def vcf = process.out.vcf[0][1].toString()
            def records = path(vcf).linesGzip.findAll { l -> !l.startsWith('#') }
            def tabix = ['tabix', '-f', '-p', 'vcf', vcf].execute()
            tabix.waitFor()
            assertAll(
                { assert process.success },
                { assert records.collect { l -> l.split('\t')[1] } == [ '1001', '2001', '2500', '3001' ] },
                { assert path(process.out.sites[0][1]).readLines() == [ "chrA\t1001\tA\tC", "chrA\t2001\tT\tA,G", "chrA\t2500\tAT\tA", "chrA\t3001\tA\tC" ] },
                { assert path(process.out.summary[0][1]).readLines()[1] == "Zx0540_P3_BC2S3\t1\t6\t4\t2\t0.666667" },
                { assert tabix.exitValue() == 0 },
                { assert path(vcf).linesGzip.count { l -> l.startsWith('##') } == 8 },
                { assert snapshot(process.out.sites, process.out.summary).match() }
            )
        }
    }

    test("Zx.0540_P3.chrA - veto at >= 2 ALT reads") {

        when {
            params {
                veto_test_args = '--min-alt-reads 2'
            }
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA' ], file("${projectDir}/modules/local/witness_veto/tests/data/inbed.vcf.gz", checkIfExists: true) ]
                input[1] = 'Zx0540_P3_BC2S3'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.sites[0][1]).readLines() == [ "chrA\t2500\tAT\tA" ] }
            )
        }
    }

    test("witness not in the VCF - fails") {

        when {
            process {
                """
                input[0] = [ [ id:'Zx.0540_P3.chrA' ], file("${projectDir}/modules/local/witness_veto/tests/data/inbed.vcf.gz", checkIfExists: true) ]
                input[1] = 'Zx0570_P2_BC2S3'
                """
            }
        }

        then {
            assert process.failed
        }
    }
}
