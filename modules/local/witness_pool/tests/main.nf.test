nextflow_process {

    name "Test Process WITNESS_POOL"
    script "../main.nf"
    process "WITNESS_POOL"

    tag "modules"
    tag "modules_local"
    tag "witness_pool"

    test("Zx.0540_P3.chrA - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam", checkIfExists: true),
                      file("${projectDir}/modules/local/allele_counts/tests/data/p2.bam", checkIfExists: true) ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam.bai", checkIfExists: true),
                      file("${projectDir}/modules/local/allele_counts/tests/data/p2.bam.bai", checkIfExists: true) ],
                    'Zx0540_P3_BC2S3'
                ])
                input[1] = [ [ id:'tiny' ], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.bam[0][1]).name == "Zx0540_P3_BC2S3.bam" },
                { assert file(process.out.bam[0][2]).name == "Zx0540_P3_BC2S3.bam.bai" }
            )
        }
    }

    test("Zx.0540_P3.chrA - one read group") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'Zx.0540_P3.chrA', donor:'Zx.0540_P3', region:'chrA' ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam", checkIfExists: true),
                      file("${projectDir}/modules/local/allele_counts/tests/data/p2.bam", checkIfExists: true) ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam.bai", checkIfExists: true),
                      file("${projectDir}/modules/local/allele_counts/tests/data/p2.bam.bai", checkIfExists: true) ],
                    'Zx0540_P3_BC2S3'
                ])
                input[1] = [ [ id:'tiny' ], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            def bam = process.out.bam[0][1].toString()
            def rg_lines = ['samtools', 'view', '-H', bam].execute().text.readLines().findAll { l -> l.startsWith('@RG') }
            def rg_tags = ['samtools', 'view', bam].execute().text.readLines().collect { l -> l.split('\t').find { t -> t.startsWith('RG:Z:') } }
            assertAll(
                { assert process.success },
                { assert rg_lines == [ "@RG\tID:Zx0540_P3_BC2S3\tSM:Zx0540_P3_BC2S3\tPL:ILLUMINA" ] },
                { assert rg_tags.size() == 36 },
                { assert rg_tags.every { t -> t == 'RG:Z:Zx0540_P3_BC2S3' } },
                { assert file(process.out.bam[0][2]).exists() }
            )
        }
    }

    test("witness name with a dot - fails") {

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'Zx.0540_P3.chrA' ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam", checkIfExists: true) ],
                    [ file("${projectDir}/modules/local/allele_counts/tests/data/p1.bam.bai", checkIfExists: true) ],
                    'Zx.0540_P3_BC2S3'
                ])
                input[1] = [ [ id:'tiny' ], file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true), file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true) ]
                """
            }
        }

        then {
            assert process.failed
        }
    }
}
