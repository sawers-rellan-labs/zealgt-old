// Module test config: the store publishDir of conf/genotype_modules.config, under the test's own store (params.store), and the
// step-2 options from a test param (conf/genotype_modules.config builds them from the run-card params).
params {
    test_ext_args = ''
}

process {
    withName: 'GAP_FILLING_LINES' {
        publishDir = [ path: { "${params.store}/genotype/test/gap_lines/gt_set" }, mode: 'copy', overwrite: false, failOnError: true ]
        ext.args = { params.test_ext_args ?: '' }
    }
}
