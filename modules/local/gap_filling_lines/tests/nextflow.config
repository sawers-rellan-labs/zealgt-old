// Module test config: the storeDir of conf/genotype_modules.config, under the test's own store (params.store), and the
// step-2 options from a test param (conf/genotype_modules.config builds them from the run-card params).
params {
    test_ext_args = ''
}

process {
    withName: 'GAP_FILLING_LINES' {
        storeDir = { "${params.store}/genotype/test/gap_lines/gt_set" }
        ext.args = { params.test_ext_args ?: '' }
    }
}
