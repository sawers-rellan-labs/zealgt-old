// Module test config: the store publishDir of conf/genotype_modules.config, under the test's own store (params.outdir).
process {
    withName: 'DONOR_FOUNDER' {
        publishDir = [ path: { "${params.outdir}/genotype/test/donor_alleles/gt_set" }, mode: 'copy', overwrite: false, failOnError: true ]
    }
}
