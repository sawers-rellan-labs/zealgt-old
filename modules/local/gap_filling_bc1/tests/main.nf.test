nextflow_process {

    name "Test Process GAP_FILLING_BC1"
    script "../main.nf"
    process "GAP_FILLING_BC1"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "gap_filling_bc1"
    tag "stub"

    test("gt_set.chrA_1-5000 - stub") {

        options "-stub"

        when {
            params {
                store = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'gt_set.chrA_1-5000', donor_set:'gt_set', region:'chrA_1-5000' ],
                    file("${projectDir}/modules/local/gap_filling_bc1/tests/data/gt_set.chrA_1-5000.union.tsv", checkIfExists: true),
                    [
                        file("${projectDir}/modules/local/gap_filling_bc1/tests/data/joint/Zx.0001_P1.chrA_1-5000.sites.tsv", checkIfExists: true),
                        file("${projectDir}/modules/local/gap_filling_bc1/tests/data/joint/Zx.0002_P1.chrA_1-5000.sites.tsv", checkIfExists: true)
                    ]
                ])
                input[1] = [ 'Zx.0001_P1', 'Zx.0002_P1' ]
                input[2] = [ 'Zx.0001_P1': 'mexicana', 'Zx.0002_P1': 'mexicana', 'Zx.0570_P2': 'mexicana' ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.calls[0][1]).name == "gt_set.chrA_1-5000.tsv.gz" },
                { assert file(process.out.summary[0][1]).name == "gt_set.chrA_1-5000.summary.tsv" },
                { assert file("${outputDir}/store_stub/genotype/test/gap_bc1/gt_set.chrA_1-5000.tsv.gz").exists() }
            )
        }
    }
}
