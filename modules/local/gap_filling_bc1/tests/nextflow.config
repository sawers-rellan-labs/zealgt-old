// Module test config: the store publishDir of conf/genotype_modules.config, under the test's own store (params.outdir).
process {
    withName: 'GAP_FILLING_BC1' {
        publishDir = [ path: { "${params.outdir}/genotype/test/gap_bc1" }, mode: 'copy', overwrite: false, failOnError: true ]
    }
}
