nextflow_process {

    name "Test Process READ_POSITION_QC"
    script "../main.nf"
    process "READ_POSITION_QC"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "read_position_qc"
    tag "stub"

    test("S1 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = channel.of([
                    [ id:'Zx.0001_P1.chrA_1-5000.lines', donor:'Zx.0001_P1', region:'chrA_1-5000', role:'line' ],
                    [ file("${projectDir}/modules/local/read_position_qc/tests/data/S1.bam", checkIfExists: true) ],
                    [ file("${projectDir}/modules/local/read_position_qc/tests/data/S1.bam.bai", checkIfExists: true) ],
                    [ 'S1' ]
                ])
                input[1] = [ [ id:'Zx.0001_P1.chrA_1-5000' ], file("${projectDir}/modules/local/read_position_qc/tests/data/sites.tsv", checkIfExists: true) ]
                input[2] = [
                    [ id:'tiny' ],
                    file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/ref/tiny.fa.fai", checkIfExists: true)
                ]
                input[3] = 'chrA:1-5000'
                input[4] = 'masked'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.tsv[0][1]).name == "Zx.0001_P1.chrA_1-5000.lines.read_position_qc.tsv" }
            )
        }
    }
}
