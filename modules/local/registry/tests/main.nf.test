nextflow_process {

    name "Test Process REGISTRY"
    script "../main.nf"
    process "REGISTRY"

    tag "modules"
    tag "modules_local"
    tag "registry"
    tag "stub"

    test("LIBX - stub") {

        options "-stub"

        when {
            params {
                outdir = "${outputDir}/store_stub"
            }
            process {
                """
                input[0] = channel.of([
                    [ id:'LIBX' ],
                    file("${projectDir}/tests/fixtures/samples_test.csv", checkIfExists: true),
                    [ file("${projectDir}/tests/fixtures/ref/tiny.fa", checkIfExists: true) ],
                    [ 'LX_1', 'LX_2', 'LX_3' ]
                ])
                input[1] = '/stub/store'
                input[2] = 'nftest'
                input[3] = 'stub'
                input[4] = 0
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert file(process.out.tsv[0][1]).name == "LIBX.registry.tsv" },
                { assert file(process.out.tsv[0][1]).readLines().size() == 4 }
            )
        }
    }
}
