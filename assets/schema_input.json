{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/sawers-rellan-labs/zealgt/main/assets/schema_input.json",
    "title": "sawers-rellan-labs/zealgt - params.input schema (meta/samples.csv, built by meta/build_samples.py)",
    "description": "The single sample sheet of the CRAM workflow: library, raw location, inline barcodes and read-group fields per sample. --entry read_demultiplexing takes the rows of the --libraries it names; all samples of one library must agree on source, barcode_layout, raw_location, raw_r1, raw_r2 and rg_pu (checked by meta/build_samples.py and again when the library is read).",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "meta": [
                    "sample_id"
                ],
                "errorMessage": "sample_id: letters, digits, _ . - only (and unique in the sheet)"
            },
            "source": {
                "type": "string",
                "enum": [
                    "bc1",
                    "bc2s3_batch1",
                    "bc2s3_batch2"
                ],
                "meta": [
                    "source"
                ]
            },
            "role": {
                "type": "string",
                "meta": [
                    "role"
                ]
            },
            "library": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": [
                    "library"
                ]
            },
            "library_index": {
                "meta": [
                    "library_index"
                ]
            },
            "raw_location": {
                "type": "string",
                "pattern": "^(/|tests/fixtures/)\\S+$",
                "meta": [
                    "raw_location"
                ],
                "errorMessage": "raw_location: absolute directory of the raw library (a path relative to the pipeline directory is allowed only under tests/fixtures/)"
            },
            "raw_r1": {
                "type": "string",
                "meta": [
                    "raw_r1"
                ]
            },
            "raw_r2": {
                "type": "string",
                "meta": [
                    "raw_r2"
                ]
            },
            "barcode_r1": {
                "type": "string",
                "pattern": "^[ACGT]+$",
                "meta": [
                    "barcode_r1"
                ]
            },
            "barcode_r2": {
                "type": "string",
                "pattern": "^[ACGT]*$",
                "meta": [
                    "barcode_r2"
                ]
            },
            "barcode_layout": {
                "type": "string",
                "enum": [
                    "symmetric",
                    "r1_only"
                ],
                "meta": [
                    "barcode_layout"
                ]
            },
            "plate": {
                "meta": [
                    "plate"
                ]
            },
            "well": {
                "meta": [
                    "well"
                ]
            },
            "donor": {
                "type": "string",
                "meta": [
                    "donor"
                ]
            },
            "taxon": {
                "type": "string",
                "meta": [
                    "taxon"
                ]
            },
            "nil_id": {
                "meta": [
                    "nil_id"
                ]
            },
            "pedigree": {
                "meta": [
                    "pedigree"
                ]
            },
            "is_check": {
                "meta": [
                    "is_check"
                ]
            },
            "rg_lb": {
                "type": "string",
                "meta": [
                    "rg_lb"
                ]
            },
            "rg_pl": {
                "type": "string",
                "meta": [
                    "rg_pl"
                ]
            },
            "rg_pu": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.,]*$",
                "meta": [
                    "rg_pu"
                ],
                "errorMessage": "rg_pu: read-group PU, flowcell.lane[,flowcell.lane...]; empty = derived from the Novogene lane file names"
            }
        },
        "required": [
            "sample_id",
            "source",
            "library",
            "raw_location",
            "barcode_r1",
            "barcode_layout"
        ]
    },
    "uniqueEntries": [
        "sample_id"
    ]
}
