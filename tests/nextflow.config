/*
========================================================================================
    Nextflow config file for running nf-test tests (nf-test.config: profile test)
========================================================================================
    Tests run on the fixtures in tests/fixtures (conf/test.config); nothing is fetched. Stored outputs go to --outdir, the
    test's own outputDir, so they never leave the test.
*/

// Template test-data locations (lint nf_test_content); zealgt tests read only tests/fixtures.
params {
    modules_testdata_base_path   = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
}

process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
