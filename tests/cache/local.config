// scripts/test_cache.sh, mode `local` (laptop): real tools on PATH (no conda), local executor. With -profile test.
// Baseline resources of R1 / R3 / R4; R2 adds raise_local.config. Every value here is a directive (not in the task hash).
// DEMUX stays at 1 cpu through conf/test.config (cutadapt -j 2 with gz outputs crashes on macOS).
conda.enabled = false
process {
    executor       = 'local'
    cpus           = 2
    memory         = 4.GB
    time           = 30.min
    errorStrategy  = 'terminate'
    maxRetries     = 0
    resourceLimits = [ cpus: 2, memory: 4.GB, time: 1.h ]
}
executor {
    name      = 'local'
    queueSize = 2
}
