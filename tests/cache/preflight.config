// scripts/test_cache.sh preflight: a -stub run with R2's profiles and configs (incl. the raise config) whose trace shows
// the resources R2's tasks would get. Only WHERE tasks run changes: local executor with a pool large enough that nothing
// is refused (as scripts/check_resources.sh). Conda stays as the profile sets it (hazel: the prebuilt prefixes, needed
// by the nf-core modules' eval versions; laptop: off, real tools on PATH).
executor {
    name      = 'local'
    cpus      = 64
    memory    = '1 TB'
    queueSize = 8
}
process.executor = 'local'
