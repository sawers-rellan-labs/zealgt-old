// scripts/test_cache.sh R2, mode `local`: raise cpus, memory and time of EVERY process above what R1 got (R1's trace: at
// most 2 cpus / 4 GB / 1 h, from tests/cache/local.config, the base.config labels and test.config's DEMUX 1 cpu). Loaded
// last (-c), and the selector key '.*' exists nowhere else, so it is applied after every other withName block; the
// preflight stub run checks that it really did (trace vs R1's trace). resourceLimits is raised too, or the new values
// would be trimmed back.
process {
    resourceLimits = [ cpus: 4, memory: 8.GB, time: 2.h ]
    withName: '.*' {
        cpus   = 3
        memory = 6.GB
        time   = 90.min
    }
}
