// scripts/test_cache.sh R2, mode `hazel` (-profile hazel,short): raise cpus, memory and time of EVERY process above what
// R1 got (tests/expected_resources.tsv, short rows: at most 8 cpus, 48 GB (ALIGN_MARKDUP, params.align_memory_gb), 1 h).
// Loaded last (-c), and the selector key '.*' exists nowhere else, so it is applied after every other withName block; the
// preflight stub run checks that it really did (trace vs R1's trace). resourceLimits is raised too (short.config caps time
// at 1 h); 1.5 h still fits the short QOS (2 h) and 12 cpus / 64 GB fit the smallest node (20 cpus / 125 GB), should a task
// not be cached. (Hazel run 989709 on 4127553: 48 GB here equalled ALIGN_MARKDUP's own request, the only failed assertion.)
process {
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 2.h ]
    withName: '.*' {
        cpus   = 12
        memory = 64.GB
        time   = 90.min
    }
}
